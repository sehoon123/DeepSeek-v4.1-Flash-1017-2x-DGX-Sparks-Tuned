+    fn readExpertsCb(a: std.mem.Allocator, io: std.Io, kit: []const u8) ![]const u8 {
+        if (std.c.getenv("TF_DS_EXPERTS_CUBIN")) |v| {
+            const path = std.mem.span(v);
+            if (path.len > 0) {
+                std.log.info("experts cubin: {s} (TF_DS_EXPERTS_CUBIN)", .{path});
+                return std.Io.Dir.cwd().readFileAllocOptions(io, path, a, .limited(1 << 28), .@"16", null);
+            }
+        }
+        return readKit(a, io, kit, "experts_cb.cubin");
+    }
