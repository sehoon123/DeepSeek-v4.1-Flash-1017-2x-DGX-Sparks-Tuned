-                else l.policy_score = @max(-4, l.policy_score - 2);
-                if (l.policy_score >= 4) l.policy_k = 5;
-                if (l.policy_score <= 0) l.policy_k = 3;
+            if (self.adapt_k and self.streams.count() <= self.adapt_max_live) {
+                if (proposed >= 4) {
+                    if (accepted >= self.adapt_accept) {
+                        l.policy_score = @min(8, l.policy_score + 2);
+                        l.probe_period = self.adapt_period;
+                    } else {
+                        l.policy_score = @max(-4, l.policy_score - 2);
+                        if (self.adapt_backoff and l.policy_k == 3) l.probe_period = @min(self.adapt_max_period, @max(self.adapt_period, @max(@as(usize, 1), l.probe_period) * 2));
+                    }
+                    if (l.policy_score >= 4) l.policy_k = 5;
+                    if (l.policy_score <= 0) l.policy_k = 3;
+                    l.probe_in = if (l.probe_period == 0) self.adapt_period else l.probe_period;
+                } else if (l.policy_k == 3 and l.probe_in > 0) l.probe_in -= 1;
             }
         }
     }
@@ -753,7 +765,7 @@ pub const Lanes = struct {
         }
         if (self.adapt_k) {
             const crowded = self.streams.count() > self.adapt_max_live;
-            const probe = !crowded and l.policy_k == 3 and l.policy_rounds % self.adapt_period == self.adapt_period - 1;
+            const probe = !crowded and l.policy_k == 3 and l.probe_in == 0;
             const k = if (crowded) @as(usize, 3) else if (probe) @as(usize, 5) else l.policy_k;
             for (out, 0..) |*o, j| o.* = if (j < k) 1.0 else 0.0;
             return true;
