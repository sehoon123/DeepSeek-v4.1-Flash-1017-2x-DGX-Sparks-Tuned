@@ -265,6 +265,8 @@ const Lane = struct {
     policy_rounds: u64 = 0,
     policy_score: i32 = 0,
     policy_k: usize = 3,
+    probe_in: usize = 0,
+    probe_period: usize = 0,
     proposed: [6]u64 = @splat(0),
     accepted: [6]u64 = @splat(0), // the prompt's draw (a handle)
     held: [draft.max_block]u32 = undefined,
@@ -304,6 +306,8 @@ pub const Lanes = struct {
     adapt_period: usize = 8,
     adapt_accept: usize = 4, // accepted drafts a K5 observation needs to raise/hold K5
     adapt_max_live: usize = 2, // above this concurrency K3 is the measured exact/fast policy
+    adapt_backoff: bool = false, // failed K5 probes exponentially become rarer for low-acceptance prose
+    adapt_max_period: usize = 32,
     policy_log: bool = false,
     drawn: [ring]u32 = undefined,
     next: u64 = 0,
@@ -673,11 +677,19 @@ pub const Lanes = struct {
             l.proposed[proposed] += 1;
             l.accepted[proposed] += accepted;
             l.policy_rounds += 1;
