@@ -716,6 +716,9 @@ pub fn partner(ch: *const Chunk, e: *const Engine, a: *Arena) !Chunk {
     p.comb = try a.take(cap * hc * hc * 4);
     p.gm = try a.take(e.world * cap * d * 4);
     if (ch.cidx != 0) p.cidx = try a.take(cap * c.index_topk * 8);
+    // its own attention partial and gather (TF_DS_PAIR_OVERLAP: the first chunk's gather runs beside the second's attention)
+    p.pa = try a.take(cap * d * 4);
+    p.ga = try a.take(e.world * cap * d * 4);
     return p;
 }
 
@@ -1115,6 +1118,12 @@ pub fn scale(hd: usize) f32 {
 }
 
 /// Comm.gather: [world, n, D] fp32 of every rank's partial, in rank order.
+/// TF_DS_PAIR_OVERLAP: gather() of the chunk's rows on `stream` (a pair's side stream; one rank the same as the other).
+pub fn gatherOn(e: *const Engine, ch: *const Chunk, src: u64, dst: u64, stream: cuda.Stream) !void {
+    if (e.two != null) return error.NotPorted;
+    try e.comm.allGather(src, dst, ch.n * e.c.hidden, .f32, stream);
+}
+
 pub fn gather(e: *const Engine, ch: *const Chunk, src: u64, dst: u64) !void {
     if (e.two) |t| return t.quarters(e, src, dst, ch.n, t.ow, 4); // 2D: the same [2, n, D] from the four quarters
     try e.comm.allGather(src, dst, ch.n * e.c.hidden, .f32, e.s);
