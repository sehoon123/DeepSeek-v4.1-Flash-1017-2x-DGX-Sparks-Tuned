     nheld: usize = 0,
@@ -295,6 +300,9 @@ pub const Lanes = struct {
     fix_k: ?usize = null, // a measurement (tf-dsv41-lanes --fix-k): K drafts a stream, chances 1 to K and 0 past it
     min_k: usize = 0, // TF_DS_MIN_K: trust at least this many drafts, then the drafter's calibrated confidences
     conf_bias: f64 = 0, // TF_DS_CONF_BIAS: add to every confidence logit before its sigmoid
+    adapt_k: bool = false, // TF_DS_ADAPT_K: probe K5 and keep it only while its observed acceptance supports it
+    adapt_period: usize = 8,
