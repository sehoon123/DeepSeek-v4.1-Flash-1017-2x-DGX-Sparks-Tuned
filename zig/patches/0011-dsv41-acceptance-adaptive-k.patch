+        if (self.policy_log) std.log.info("draft-policy stream={s} rounds={d} score={d} k={d} proposed={any} accepted={any}", .{ s.id, kv.value.policy_rounds, kv.value.policy_score, kv.value.policy_k, kv.value.proposed, kv.value.accepted });
         self.used[kv.value.slot] = false;
     }
 };
