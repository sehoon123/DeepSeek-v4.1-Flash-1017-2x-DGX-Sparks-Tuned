@@ -653,10 +661,22 @@ pub const Lanes = struct {
 
     /// The caches are positional: the next window starts at the stream's new length and writes over the rows past it.
     fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
-        _ = ptr;
-        for (windows, paths) |_, path| {
+        const self = of(ptr);
+        for (windows, paths) |w, path| {
             if (path.len == 0) return error.EmptyPath;
             for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            const l = self.streams.getPtr(w.stream) orelse return error.UnknownStream;
+            const proposed = @min(@as(usize, 5), w.rows() - 1);
+            const accepted = @min(proposed, path.len - 1);
+            l.proposed[proposed] += 1;
+            l.accepted[proposed] += accepted;
+            l.policy_rounds += 1;
+            if (self.adapt_k and proposed >= 4) {
+                if (accepted >= 4) l.policy_score = @min(8, l.policy_score + 2)
+                else l.policy_score = @max(-4, l.policy_score - 2);
+                if (l.policy_score >= 4) l.policy_k = 5;
+                if (l.policy_score <= 0) l.policy_k = 3;
+            }
         }
     }
 
@@ -729,6 +749,12 @@ pub const Lanes = struct {
             for (out, 0..) |*o, j| o.* = if (j < k) 1.0 else 0.0;
             return true;
         }
+        if (self.adapt_k) {
+            const probe = l.policy_k == 3 and l.policy_rounds % self.adapt_period == self.adapt_period - 1;
+            const k = if (probe) @as(usize, 5) else l.policy_k;
+            for (out, 0..) |*o, j| o.* = if (j < k) 1.0 else 0.0;
+            return true;
+        }
         survivalsBiased(l.confs[0..out.len], out, self.conf_bias);
