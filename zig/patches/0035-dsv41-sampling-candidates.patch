+            1 => -0.0,
+            2 => @floatFromInt(rnd.uintLessThan(u32, 4)),
+            3 => if (rnd.boolean()) std.math.inf(f32) else -std.math.inf(f32),
+            else => rnd.floatNorm(f32) * 4,
