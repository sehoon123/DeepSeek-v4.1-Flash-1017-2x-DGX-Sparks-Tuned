 static void run_old(const long long* d, int rows, int n, int k, long long* o) { tf_ds_topk_i64_kernel<<<rows, 1024>>>(d, n, n, k, o); }
 
+// A round's sampling candidates (sampling.topCandidates on the device): each row's first C (value, id) in the order
+// "the larger value, then the lower id" (np.lexsort((ids, -values))), -0.0 the same value as +0.0. A row holding a
+// NaN is flagged: the host draws that row from the whole row (topCandidates' own NaN handling). Phase 1: block
+// (slice, row) keeps its slice's C largest keys (C rounds of a block max over the keys, which are unique); phase 2:
+// block `row` sorts the slices' keys and writes the first C, each value read back from the row (its own bits).
+// A row's record (TF_CAND_REC words): C fp32 values at 0, C int32 ids at TF_CAND_MAX, the NaN flag at 2 * TF_CAND_MAX.
+#define TF_CAND_SLICES 32
+#define TF_CAND_MAX 64
+#define TF_CAND_REC (2 * TF_CAND_MAX + 4)
+#define TF_CAND_T1 256
+#define TF_CAND_E 16
+
+__device__ __forceinline__ unsigned long long tf_cand_key(float v, unsigned id, int& nan) {
+    unsigned b = __float_as_uint(v);
+    if ((b & 0x7fffffffu) > 0x7f800000u) { nan = 1; return 0ull; }
+    if ((b & 0x7fffffffu) == 0u) b = 0u;
+    const unsigned o = (b & 0x80000000u) ? ~b : (b | 0x80000000u);
+    return ((unsigned long long)o << 32) | (unsigned long long)(0xffffffffu - id);
+}
+
+extern "C" __global__ void __launch_bounds__(TF_CAND_T1) tf_ds_cands_slices_kernel(const float* __restrict__ logits, long long ld, int V, int C, unsigned long long* __restrict__ keys, int* __restrict__ nans) {
+    const int s = blockIdx.x, r = blockIdx.y, t = threadIdx.x;
+    const int L = (V + TF_CAND_SLICES - 1) / TF_CAND_SLICES;
+    const int lo = s * L, hi = min(V, lo + L);
+    const float* row = logits + (long long)r * ld;
+    unsigned long long k[TF_CAND_E];
+    int nan = 0;
+#pragma unroll
+    for (int e = 0; e < TF_CAND_E; ++e) {
+        const int i = lo + e * TF_CAND_T1 + t;
+        k[e] = i < hi ? tf_cand_key(row[i], (unsigned)i, nan) : 0ull;
+    }
+    __shared__ unsigned long long wmax[TF_CAND_T1 / 32];
+    __shared__ int any_nan;
+    if (t == 0) any_nan = 0;
+    __syncthreads();
+    if (nan) any_nan = 1;
+    unsigned long long* out = keys + ((long long)r * TF_CAND_SLICES + s) * TF_CAND_MAX;
+    for (int c = 0; c < C; ++c) {
+        unsigned long long m = 0ull;
+#pragma unroll
+        for (int e = 0; e < TF_CAND_E; ++e) m = k[e] > m ? k[e] : m;
+        unsigned long long w = m;
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            const unsigned long long x = __shfl_xor_sync(0xffffffffu, w, o);
+            w = x > w ? x : w;
+        }
+        if ((t & 31) == 0) wmax[t >> 5] = w;
+        __syncthreads();
+        unsigned long long g = wmax[0];
+#pragma unroll
+        for (int j = 1; j < TF_CAND_T1 / 32; ++j) g = wmax[j] > g ? wmax[j] : g;
+        __syncthreads();
+        if (t == 0) out[c] = g;
+        if (g != 0ull && m == g) {
+#pragma unroll
+            for (int e = 0; e < TF_CAND_E; ++e)
+                if (k[e] == g) k[e] = 0ull;
+        }
+    }
+    __syncthreads();
+    if (t == 0) nans[r * TF_CAND_SLICES + s] = any_nan;
+}
+
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_cands_merge_kernel(const float* __restrict__ logits, long long ld, int C, const unsigned long long* __restrict__ keys, const int* __restrict__ nans, unsigned* __restrict__ out) {
+    const int r = blockIdx.x, t = threadIdx.x;
+    const int n = TF_CAND_SLICES * TF_CAND_MAX;
+    __shared__ unsigned long long sk[TF_CAND_SLICES * TF_CAND_MAX];
+    for (int i = t; i < n; i += 1024) sk[i] = (i % TF_CAND_MAX) < C ? keys[(long long)r * n + i] : 0ull;
+    __syncthreads();
+    for (int size = 2; size <= n; size <<= 1) {
+        for (int stride = size >> 1; stride > 0; stride >>= 1) {
+            for (int i = t; i < n / 2; i += 1024) {
+                const int a = 2 * i - (i & (stride - 1));
+                const int b = a + stride;
+                const bool desc = (a & size) == 0;
+                const unsigned long long x = sk[a], y = sk[b];
+                if ((x < y) == desc) { sk[a] = y; sk[b] = x; }
+            }
+            __syncthreads();
+        }
+    }
+    unsigned* rec = out + (long long)r * TF_CAND_REC;
+    if (t < C) {
+        const unsigned id = 0xffffffffu - (unsigned)(sk[t] & 0xffffffffull);
+        rec[TF_CAND_MAX + t] = id;
+        rec[t] = __float_as_uint(logits[(long long)r * ld + id]);
+    }
+    if (t == 0) {
+        int a = 0;
+        for (int s = 0; s < TF_CAND_SLICES; ++s) a |= nans[r * TF_CAND_SLICES + s];
+        rec[2 * TF_CAND_MAX] = (unsigned)a;
+    }
+}
