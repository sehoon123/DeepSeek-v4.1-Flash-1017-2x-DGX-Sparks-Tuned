+//! The draft-survival calibration: a stream's realised over predicted drafts scales the chances its window is allocated by.
+const std = @import("std");
+const Config = @import("config.zig").Config;
+const Cost = @import("config.zig").Cost;
+const Engine = @import("engine.zig").Engine;
+const Stream = @import("stream.zig").Stream;
+const fake = @import("fake.zig");
+const be = @import("backend.zig");
+const win = @import("windows.zig");
+
+const gpa = std.testing.allocator;
+
+const chain = [_]f64{ 0.9, 0.81, 0.729, 0.6561 };
+
+fn chances(_: *anyopaque, _: *Stream, out: []f64) anyerror!bool {
+    @memcpy(out, chain[0..out.len]);
+    return true;
+}
+
+fn startNow(_: *anyopaque) void {}
+
+fn elapsed(_: *anyopaque, _: be.Mark) f64 {
+    return 0.0;
+}
+
+/// Each stream's granted drafts and predicted landings after one allocation of 4 held drafts apiece.
+fn grants(weight: f64, cals: []const f64, granted: []u32, predicted: []f64) !void {
+    var costs: [16]Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 2.0 * @as(f64, @floatFromInt(w)) };
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .window_costs = &costs, .mtp_step_ms = 0.5, .draft_probabilities = true, .draft_cal = weight }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vtable = target.backend().vtable.*;
+    vtable.probabilities = chances;
+    var token: u8 = 0;
+    var engine = Engine.init(gpa, &cfg, .{ .ptr = &target, .vtable = &vtable }, .{ .ptr = &token, .vtable = &.{ .start = startNow, .elapsed_ms = elapsed } });
+    defer engine.deinit();
+    var streams: [2]Stream = undefined;
+    var plans: [2]win.Plan = undefined;
+    for (cals, 0..) |cal, i| {
+        streams[i] = try Stream.init(gpa, .{ .id = "s", .prompt = &.{ 1, 2, 3 }, .max_new = 8 });
+        streams[i].cal = cal;
+        plans[i] = .{ .stream = &streams[i], .position = 0, .kind = .head, .held = 4 };
+    }
+    defer for (streams[0..cals.len]) |*s| s.deinit(gpa);
+    try win.allocate(&engine, plans[0..cals.len]);
+    for (streams[0..cals.len], granted, predicted) |s, *g, *p| {
+        g.* = s.granted.?;
+        p.* = s.predicted();
+    }
+}
+
+test "bundle16: off, the chances and the grant are the uncalibrated ones whatever the stream's cal" {
+    var g: [1]u32 = undefined;
+    var p: [1]f64 = undefined;
+    try grants(0.0, &.{0.3}, &g, &p);
+    try std.testing.expectEqual(@as(u32, 4), g[0]);
+    try std.testing.expectEqual(@as(f64, 0.0), p[0]);
+}
+
+test "bundle16: a cold stream is uncalibrated and predicts the drafts it was granted" {
+    var g: [1]u32 = undefined;
+    var p: [1]f64 = undefined;
+    try grants(0.5, &.{1.0}, &g, &p);
+    try std.testing.expectEqual(@as(u32, 4), g[0]);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.9 + 0.81 + 0.729 + 0.6561), p[0], 1e-12);
+}
+
+test "bundle16: a stream that realises half its drafts is granted fewer, and predicts from the uncalibrated chances" {
+    var g: [1]u32 = undefined;
+    var p: [1]f64 = undefined;
+    try grants(0.5, &.{0.5}, &g, &p);
+    try std.testing.expectEqual(@as(u32, 2), g[0]);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.9 + 0.81), p[0], 1e-12);
+}
+
+test "bundle16: the floor keeps a collapsed stream drafting" {
+    var g: [1]u32 = undefined;
+    var p: [1]f64 = undefined;
+    try grants(0.5, &.{0.05}, &g, &p);
+    try std.testing.expectEqual(@as(u32, 1), g[0]);
+    var at_floor: [1]u32 = undefined;
+    try grants(0.5, &.{0.2}, &at_floor, &p);
+    try std.testing.expectEqual(g[0], at_floor[0]);
+}
+
+test "bundle16: a shared round gives each stream its own calibration" {
+    var g: [2]u32 = undefined;
+    var p: [2]f64 = undefined;
+    try grants(0.5, &.{ 1.0, 0.2 }, &g, &p);
+    try std.testing.expectEqual(@as(u32, 4), g[0]);
+    try std.testing.expectEqual(@as(u32, 0), g[1]);
+}
+
+test "bundle16: the survival solves the chances landed for the kept drafts" {
+    const p = [_]f64{ 0.97, 0.94, 0.91, 0.88 };
+    const c = Stream.survival(&p, 2.55);
+    try std.testing.expect(c > 0.84 and c < 0.87);
+    try std.testing.expectEqual(@as(f64, 1.0), Stream.survival(&p, 4.0));
+    try std.testing.expectEqual(@as(f64, 1.0), Stream.survival(&p, 3.7));
+    try std.testing.expectEqual(@as(f64, 0.2), Stream.survival(&p, 0.0));
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5), Stream.survival(&.{0.9}, 0.45), 1e-6);
+    try std.testing.expectEqual(@as(f64, 1.0), Stream.survival(&p, 40.0));
+}
+
+test "bundle16: the average moves by the weight toward the round's kept and expected drafts" {
+    var s = try Stream.init(gpa, .{ .id = "s", .prompt = &.{1}, .max_new = 8 });
+    defer s.deinit(gpa);
+    s.observeCal(0.5, 3.0);
+    try std.testing.expectEqual(@as(f64, 1.0), s.cal);
+    s.predict(&.{0.9});
+    s.observeCal(0.5, 0.0);
+    try std.testing.expectEqual(@as(f64, 0.2), s.cal);
+    s.predict(&.{0.9});
+    s.observeCal(0.5, 1.0);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5 / 0.9), s.cal, 1e-6);
+    s.cal = 0.0;
+    try std.testing.expectEqual(@as(f64, 0.2), s.calScale());
+}
+
+/// The cal after 20 rounds of 4 drafts whose true per-draft survival is `factor` (its expected kept drafts).
+fn converged(factor: f64) f64 {
+    var s = Stream.init(gpa, .{ .id = "s", .prompt = &.{1}, .max_new = 8 }) catch unreachable;
+    defer s.deinit(gpa);
+    const raw = [_]f64{ 0.97, 0.94, 0.91, 0.88 };
+    var kept: f64 = 0.0;
+    var f: f64 = 1.0;
+    for (raw) |p| {
+        f *= factor;
+        kept += f * p;
+    }
+    for (0..20) |_| {
+        s.predict(&raw);
+        s.observeCal(0.3, kept);
+    }
+    return s.cal;
+}
+
+test "bundle16: prose-like and code-like streams settle near their per-draft survival" {
+    try std.testing.expectApproxEqAbs(@as(f64, 0.85), converged(0.85), 0.01);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.99), converged(0.99), 0.01);
+}
+
+/// The mean scale over many rounds of a chain whose drafts survive at `factor` times the predicted rate, drawn at random.
+fn meanScale(factor: f64) f64 {
+    var s = Stream.init(gpa, .{ .id = "s", .prompt = &.{1}, .max_new = 8 }) catch unreachable;
+    defer s.deinit(gpa);
+    var prng = std.Random.DefaultPrng.init(7);
+    const rng = prng.random();
+    const q = 0.85;
+    var raw: [4]f64 = undefined;
+    var reach: f64 = 1.0;
+    for (&raw) |*p| {
+        reach *= q;
+        p.* = reach;
+    }
+    var total: f64 = 0.0;
+    const rounds = 4000;
+    for (0..rounds) |_| {
+        var kept: f64 = 0.0;
+        for (0..raw.len) |_| {
+            if (rng.float(f64) >= factor * q) break;
+            kept += 1.0;
+        }
+        s.predict(&raw);
+        s.observeCal(0.2, kept);
+        total += s.calScale();
+    }
+    return total / rounds;
+}
+
+test "bundle16: noise does not drag a well calibrated stream's scale down, and a short one still shows" {
+    try std.testing.expect(meanScale(1.0) > 0.95);
+    const low = meanScale(0.8);
+    try std.testing.expect(low > 0.72 and low < 0.88);
+}
+
+test "bundle16: the probe counts every calibrated verify, logged on its period or not" {
+    var s = try Stream.init(gpa, .{ .id = "probe", .prompt = &.{1}, .max_new = 8 });
+    defer s.deinit(gpa);
+    s.predict(&.{ 0.9, 0.81 });
+    s.observeCal(0.2, 1.0);
+    s.logCal(1, 3, 1, 2);
+    s.logCal(0, 3, 1, 2);
+    s.cal_n = 0;
+    s.logCal(1, 1, 0, 1);
+    try std.testing.expectEqual(@as(u64, 3), s.cal_rounds);
+}
+
+test "bundle16: the weight must lie in 0..1" {
+    for ([_]f64{ -0.1, 1.5, std.math.nan(f64), std.math.inf(f64) }) |bad| {
+        try std.testing.expectError(error.BadDraftCal, Config.init(gpa, .{ .draft_cal = bad }, 16, 15));
+    }
+    var ok = try Config.init(gpa, .{ .draft_cal = 1.0 }, 16, 15);
+    ok.deinit(gpa);
+}
+
+/// A head that claims every draft lands (0.99 each), where fake.zig's head guesses about one draft in five wrong.
+fn overconfident(_: *anyopaque, _: *Stream, out: []f64) anyerror!bool {
+    var reach: f64 = 1.0;
+    for (out) |*o| {
+        reach *= 0.99;
+        o.* = reach;
+    }
+    return true;
+}
+
+const Decoded = struct { reply: []u32, drafted: u64, rounds: u64 };
+
+/// A drafted stream decoded to its end on the fake target with the overconfident head (gpa owns the reply).
+fn decode(weight: f64) !Decoded {
+    var costs: [16]Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 2.0 * @as(f64, @floatFromInt(w)) };
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .window_costs = &costs, .mtp_step_ms = 0.5, .draft_probabilities = true, .draft_cal = weight }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vtable = target.backend().vtable.*;
+    vtable.probabilities = overconfident;
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, .{ .ptr = &target, .vtable = &vtable }, clock.clock());
+    defer engine.deinit();
+    var s = try Stream.init(gpa, .{ .id = "s", .prompt = &.{ 3, 1, 4, 1, 5 }, .max_new = 120, .eos = &.{96} });
+    defer s.deinit(gpa);
+    try engine.addStream(&s);
+    while (engine.activeCount() > 0) try engine.step();
+    return .{ .reply = try gpa.dupe(u32, s.emitted()), .drafted = s.drafted, .rounds = s.cal_rounds };
+}
+
+test "bundle16: on, an overconfident head's stream verifies fewer drafts for the same reply" {
+    const off = try decode(0.0);
+    defer gpa.free(off.reply);
+    const on = try decode(0.5);
+    defer gpa.free(on.reply);
+    try std.testing.expectEqualSlices(u32, off.reply, on.reply);
+    try std.testing.expectEqual(@as(u64, 0), off.rounds);
+    try std.testing.expect(on.rounds > 0 and on.drafted < off.drafted);
+}
+
+fn sharedChances(_: *anyopaque, s: *Stream, out: []f64) anyerror!bool {
+    const held: []const f64 = switch (s.id[0]) {
+        'h' => &.{ 0.9, 0.81, 0.729, 0.6561 },
+        'l' => &.{ 0.6, 0.3, 0.12, 0.05 },
+        else => return false, // the depth rule's chances: the class prior's
+    };
+    @memcpy(out, held[0..out.len]);
+    return true;
+}
+
+test "bundle16: unset, a shared round's windows and grants are the pre-port allocator's whatever each stream's cal" {
+    var costs: [16]Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 2.0 * @as(f64, @floatFromInt(w)) };
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .window_costs = &costs, .mtp_step_ms = 0.5, .draft_probabilities = true }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vtable = target.backend().vtable.*;
+    vtable.probabilities = sharedChances;
+    var token: u8 = 0;
+    var engine = Engine.init(gpa, &cfg, .{ .ptr = &target, .vtable = &vtable }, .{ .ptr = &token, .vtable = &.{ .start = startNow, .elapsed_ms = elapsed } });
+    defer engine.deinit();
+    const ids = [_][]const u8{ "forced", "copy", "high", "low", "rule" };
+    var streams: [ids.len]Stream = undefined;
+    for (&streams, ids) |*s, id| s.* = try Stream.init(gpa, .{ .id = id, .prompt = &.{ 1, 2, 3 }, .max_new = 64 });
+    defer for (&streams) |*s| s.deinit(gpa);
+    for (&streams) |*s| s.cal = 0.3;
+    var plans = [_]win.Plan{
+        .{ .stream = &streams[0], .position = 3, .kind = .forced, .forced = &.{ 5, 6 }, .tokens = &.{ 5, 6 } },
+        .{ .stream = &streams[1], .position = 3, .kind = .copy, .tokens = &.{ 7, 8, 9, 10, 11, 12 } },
+        .{ .stream = &streams[2], .position = 3, .kind = .head, .held = 4 },
+        .{ .stream = &streams[3], .position = 3, .kind = .head, .held = 4 },
+        .{ .stream = &streams[4], .position = 3, .kind = .head, .held = 3 },
+    };
+    try win.allocate(&engine, &plans);
+    const Got = struct { kind: win.Kind, held: u32, tokens: []const u32, granted: ?u32 };
+    // the allocator's result on these plans before the calibration existed
+    const recorded = [_]Got{
+        .{ .kind = .forced, .held = 0, .tokens = &.{ 5, 6 }, .granted = null },
+        .{ .kind = .copy, .held = 0, .tokens = &.{ 7, 8, 9, 10, 11 }, .granted = null },
+        .{ .kind = .head, .held = 3, .tokens = &.{}, .granted = 3 },
+        .{ .kind = .none, .held = 0, .tokens = &.{}, .granted = 0 },
+        .{ .kind = .head, .held = 1, .tokens = &.{}, .granted = 1 },
+    };
+    var got: [recorded.len]Got = undefined;
+    for (&got, plans) |*g, p| g.* = .{ .kind = p.kind, .held = p.held, .tokens = p.tokens, .granted = p.stream.granted };
+    try std.testing.expectEqualDeep(recorded, got);
+    for (streams) |s| try std.testing.expectEqual(@as(usize, 0), s.cal_n);
+}
+
+test "bundle16: a stream granted no drafts in a shared round relaxes toward no correction and drafts again" {
+    var costs: [16]Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 2.0 * @as(f64, @floatFromInt(w)) };
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .window_costs = &costs, .mtp_step_ms = 0.5, .draft_probabilities = true, .draft_cal = 0.5 }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vtable = target.backend().vtable.*;
+    vtable.probabilities = chances;
+    var token: u8 = 0;
+    var engine = Engine.init(gpa, &cfg, .{ .ptr = &target, .vtable = &vtable }, .{ .ptr = &token, .vtable = &.{ .start = startNow, .elapsed_ms = elapsed } });
+    defer engine.deinit();
+    var streams: [2]Stream = undefined;
+    for (&streams, [_]f64{ 1.0, 0.2 }) |*s, cal| {
+        s.* = try Stream.init(gpa, .{ .id = "s", .prompt = &.{ 1, 2, 3 }, .max_new = 8 });
+        s.cal = cal;
+    }
+    defer for (&streams) |*s| s.deinit(gpa);
+    var granted: [4]u32 = undefined;
+    for (&granted) |*g| {
+        var plans: [2]win.Plan = undefined;
+        for (&plans, &streams) |*p, *s| p.* = .{ .stream = s, .position = 0, .kind = .head, .held = 4 };
+        try win.allocate(&engine, &plans);
+        g.* = streams[1].granted.?;
+    }
+    // the shared round's first grant is none (as in the test above); each undrafted round moves cal 0.2 -> 0.6 -> 0.8
+    try std.testing.expectEqual(@as(u32, 0), granted[0]);
+    try std.testing.expect(std.mem.max(u32, &granted) > 0);
+    try std.testing.expectEqual(@as(f64, 1.0), streams[0].cal);
+}
