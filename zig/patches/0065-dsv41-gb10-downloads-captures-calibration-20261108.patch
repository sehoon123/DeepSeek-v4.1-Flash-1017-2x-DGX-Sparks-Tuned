+    driver.api.cuStreamBeginCapture_v2 = Fake.begin;
+    driver.api.cuEventRecord = Fake.record;
+    driver.api.cuStreamWaitEvent = Fake.wait;
+    driver.api.cuStreamEndCapture = Fake.end;
