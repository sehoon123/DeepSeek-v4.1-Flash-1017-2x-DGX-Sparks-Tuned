+            put(.record);
+            return abi.success;
+        }
+        fn wait(_: abi.Stream, _: abi.Event, _: c_uint) callconv(.c) abi.Result {
+            put(.wait);
+            return if (refuse) abi.error_not_ready else abi.success;
+        }
+        fn end(_: abi.Stream, g: *abi.Graph) callconv(.c) abi.Result {
+            put(.end);
+            if (refuse) return abi.error_not_ready;
+            g.* = @ptrFromInt(0x60);
+            return abi.success;
+        }
+        fn destroy(_: abi.Graph) callconv(.c) abi.Result {
+            put(.destroy);
+            return abi.success;
+        }
