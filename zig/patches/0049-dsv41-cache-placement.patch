+test "placement refusal preserves snapshots when only live extents prevent admission" {
+    const gpa = std.testing.allocator;
+    var m: Model = undefined;
+    m.pool_cap = 1048576;
+    var ln: Lanes = .{ .gpa = gpa, .m = &m, .peer = null };
+    defer ln.snaps.deinit(gpa);
+    var older: Snap = .{ .id = 1, .base = 0, .at = 673792, .end = 714752, .buf = undefined };
+    var source: Snap = .{ .id = 2, .base = 0, .at = 679936, .end = 714752, .buf = undefined };
+    var other: Snap = .{ .id = 3, .base = 714752, .at = 40960, .end = 790528, .buf = undefined };
+    try ln.snaps.appendSlice(gpa, &.{ &older, &source, &other });
+    const live = [_][2]usize{.{ 714752, 790528 }};
+    const size = 716800; // a 683574-token prompt plus output/round reservations, aligned
+    try std.testing.expect(place(&live, size, m.pool_cap) == null);
+    try std.testing.expectError(error.ContextFull, ln.placeResume(&live, size, &source));
+    try std.testing.expect(!older.stale);
+    try std.testing.expect(!source.stale);
+    try std.testing.expect(!other.stale);
+    try std.testing.expectEqual(@as(u64, 0), source.wanted);
+    try std.testing.expectEqual(@as(usize, 714752), source.end);
+    // With the live extent gone, the same exact-prefix source is still eligible.
+    try std.testing.expect(ln.validSnap(&source));
+    const p = try ln.placeResume(&.{}, size, &source);
+    try std.testing.expectEqual(@as(usize, 0), p.base);
+    try std.testing.expect(p.kept == &source);
+    try std.testing.expect(!p.moved);
+}
+
+test "placement reuses its source in place after the oldest other tail blockers are evicted" {
+    const gpa = std.testing.allocator;
+    var m: Model = undefined;
+    m.pool_cap = 1048576;
+    var ln: Lanes = .{ .gpa = gpa, .m = &m, .peer = null };
+    defer ln.snaps.deinit(gpa);
+    var older: Snap = .{ .id = 1, .base = 0, .at = 673792, .end = 714752, .buf = undefined };
+    var source: Snap = .{ .id = 2, .base = 0, .at = 679936, .end = 714752, .buf = undefined };
+    var other: Snap = .{ .id = 3, .base = 714752, .at = 40960, .end = 790528, .buf = undefined };
+    try ln.snaps.appendSlice(gpa, &.{ &older, &source, &other });
+    try std.testing.expect(ln.keptOver(source.at, 716800, &source));
+    const p = try ln.placeResume(&.{}, 716800, &source);
+    try std.testing.expect(!source.stale);
+    try std.testing.expect(p.kept == &source);
+    try std.testing.expectEqual(@as(usize, 0), p.base);
+    try std.testing.expect(!p.moved); // no self-copy and no cold prefill after the blocker gave its room
+    try std.testing.expect(older.stale and other.stale);
+    try std.testing.expectEqual(@as(usize, 3), ln.snaps.items.len);
+}
+
+test "ordinary placement keeps its source in place or copies it when spare room exists" {
+    const gpa = std.testing.allocator;
+    const c = model.chunk_rows;
+    var m: Model = undefined;
+    m.pool_cap = 128 * c;
+    m.io = std.testing.io;
+    var ln: Lanes = .{ .gpa = gpa, .m = &m, .peer = null };
+    defer ln.snaps.deinit(gpa);
+    var source: Snap = .{ .id = 1, .base = 0, .at = 8 * c, .end = 10 * c, .buf = undefined };
+    try ln.snaps.append(gpa, &source);
+    const same = try ln.placeResume(&.{}, 10 * c, &source);
+    try std.testing.expectEqual(@as(usize, 0), same.base);
+    try std.testing.expect(same.kept == &source and !same.moved and !source.stale);
+    var other: Snap = .{ .id = 2, .base = 8 * c, .at = 4 * c, .end = 14 * c, .buf = undefined };
+    try ln.snaps.append(gpa, &other);
+    const copied = try ln.placeResume(&.{}, 12 * c, &source);
+    try std.testing.expectEqual(@as(usize, 14 * c + growth_rows), copied.base);
+    try std.testing.expect(copied.kept == &source and copied.moved);
+    try std.testing.expect(!source.stale and !other.stale);
+    // A source that a live stream holds is still copied only through the existing patient/roomAfter path.
+    const held = try ln.placeResume(&.{.{ 0, 14 * c }}, 12 * c, &source);
+    try std.testing.expect(held.kept == &source and held.moved);
+    try std.testing.expect(!source.stale and !other.stale);
+}
+
+test "placement cannot reuse a source extent past the pool end" {
+    const gpa = std.testing.allocator;
+    const c = model.chunk_rows;
+    var m: Model = undefined;
+    m.pool_cap = 32 * c;
+    var ln: Lanes = .{ .gpa = gpa, .m = &m, .peer = null };
+    defer ln.snaps.deinit(gpa);
+    var source: Snap = .{ .id = 1, .base = 20 * c, .at = 8 * c, .end = 30 * c, .buf = undefined };
+    try ln.snaps.append(gpa, &source);
+    const p = try ln.placeResume(&.{}, 16 * c, &source);
+    try std.testing.expectEqual(@as(usize, 0), p.base);
+    try std.testing.expect(p.kept == &source and p.moved and !source.stale);
+    try std.testing.expectError(error.ContextFull, ln.placeResume(&.{}, 33 * c, &source));
+    try std.testing.expect(!source.stale);
+}
