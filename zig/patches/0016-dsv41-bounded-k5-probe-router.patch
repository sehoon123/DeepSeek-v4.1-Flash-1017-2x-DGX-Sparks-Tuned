         }
+        if (self.probe_route) {
+            const crowded = self.streams.count() > self.adapt_max_live;
+            const probe = !crowded and !l.route_decided and l.policy_rounds % self.probe_period == self.probe_period - 1;
+            const k = if (crowded) @as(usize, 3) else if (probe) @as(usize, 5) else l.policy_k;
