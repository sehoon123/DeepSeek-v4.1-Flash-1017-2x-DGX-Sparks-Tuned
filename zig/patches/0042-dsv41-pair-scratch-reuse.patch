 /// prefill.Workspace: one rotated input xh (fp16, at least M * K) and one W_q (fp16, at least K * N), each the
 /// largest call's, reused by every call on the stream, and the bf16 Hadamard (hadamard()).
-pub const Workspace = struct { xh: u64, w: u64, h: u64 };
+pub const Workspace = struct { xh: u64, w: u64, h: u64, cache: ?*UnpackCache = null };
+
+/// Bounded, layer-local storage of immutable unpack results. A pair shares it on the SAME main CUDA stream; only
+/// unpack is omitted on a hit, never rotIn or the GEMM. PairReuse borrows the existing prompt MoE z scratch only
+/// before its expert kernels overwrite it; no additional device allocation or change to chunk boundaries.
+pub const UnpackCache = struct {
+    const Key = struct { words: u64, k: u32, n: u32, k2: u32 };
+    const Entry = struct { key: Key, ptr: u64 };
+    pub const Choice = struct { ptr: u64, hit: bool };
+    base: u64,
+    capacity: usize,
+    used: usize = 0,
+    count: usize = 0,
+    entries: [24]Entry = undefined,
+    hits: usize = 0,
+    saved_bytes: u64 = 0,
+    peak_used: usize = 0,
+
+    pub fn reset(c: *UnpackCache) void {
+        c.used = 0;
+        c.count = 0;
+    }
+
+    /// A full cache never evicts a still-used entry: missing shapes use the original workspace instead.
+    pub fn choose(c: *UnpackCache, l: weights.Linear, fallback: u64) Choice {
+        const key: Key = .{ .words = l.words, .k = l.k, .n = l.n, .k2 = l.k2 };
+        for (c.entries[0..c.count]) |entry| if (std.meta.eql(key, entry.key)) {
+            c.hits += 1;
+            c.saved_bytes += @as(u64, l.k) * l.n * 2;
+            return .{ .ptr = entry.ptr, .hit = true };
+        };
+        const miss: Choice = .{ .ptr = fallback, .hit = false };
+        const elems = std.math.mul(usize, l.k, l.n) catch return miss;
+        const bytes = std.math.mul(usize, elems, 2) catch return miss;
+        // Real EXL3 dimensions are multiples of 128, so every stored matrix keeps the arena's alignment.
+        if (l.k % 128 != 0 or l.n % 128 != 0 or bytes == 0 or
+            c.count == c.entries.len or bytes > c.capacity - c.used) return miss;
+        const ptr = c.base + c.used;
+        c.entries[c.count] = .{ .key = key, .ptr = ptr };
+        c.count += 1;
+        c.used += bytes;
+        c.peak_used = @max(c.peak_used, c.used);
+        return .{ .ptr = ptr, .hit = false };
+    }
+};
+
+/// A pair's attention-only borrow of prompt MoE z. The expert kernels overwrite every routed z value before
+/// reading it (unrouted slots do not read z); both phases are queued on the same main stream. NCCL gathers read
+/// the combined pm/gm, not z. End the borrow before pairExperts and begin anew before any next-layer lookup.
+/// Workspace references are cleared even on failure; neither a single chunk nor a nested request inherits them.
+/// Keep this owner at a stable address between begin/end.
+pub const PairReuse = struct {
+    enabled: bool,
+    first: *Workspace,
+    second: *Workspace,
+    cache: UnpackCache,
+
+    pub fn begin(r: *PairReuse) !void {
+        if (!r.enabled) return;
+        if (r.first.cache != null or r.second.cache != null) return error.UnpackCacheAlreadyBound;
+        r.cache.reset();
+        r.first.cache = &r.cache;
+        r.second.cache = &r.cache;
+    }
+
+    pub fn end(r: *PairReuse) void {
+        if (!r.enabled) return;
+        if (r.first.cache == &r.cache) r.first.cache = null;
+        if (r.second.cache == &r.cache) r.second.cache = null;
+        r.cache.reset(); // the next owner (MoE) may overwrite every byte
+    }
+};
 
