-    try unpack(k, t.stream, l, ws.w);
-    try tri_markov.matmul(t, ws.xh, ws.w, ws.h, l.svh, null, out, out_type, os, m, l.k, l.n);
+    const choice: UnpackCache.Choice = if (ws.cache) |cache| cache.choose(l, ws.w) else .{ .ptr = ws.w, .hit = false };
+    if (!choice.hit) try unpack(k, t.stream, l, choice.ptr);
+    try tri_markov.matmul(t, ws.xh, choice.ptr, ws.h, l.svh, null, out, out_type, os, m, l.k, l.n);
 }
 
