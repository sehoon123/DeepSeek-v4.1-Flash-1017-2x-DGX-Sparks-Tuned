+test "layer-local unpack cache: exact keys, capacity fallback and reset" {
+    var c: UnpackCache = .{ .base = 0x100000, .capacity = 2 * 128 * 128 * 2 };
+    const l: weights.Linear = .{ .words = 0x200000, .suh = 1, .svh = 2, .k = 128, .n = 128, .k2 = 6 };
+    const fallback = 0x300000;
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = c.base, .hit = false }, c.choose(l, fallback));
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = c.base, .hit = true }, c.choose(l, fallback));
+    var other = l;
+    other.words += 256;
+    const second = c.choose(other, fallback);
+    try std.testing.expect(!second.hit and second.ptr == c.base + 32768);
+    other.k2 += 1;
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = fallback, .hit = false }, c.choose(other, fallback));
+    try std.testing.expect(c.choose(l, fallback).hit); // fallback did not evict the first matrix
+    try std.testing.expectEqual(@as(u64, 65536), c.saved_bytes);
+    c.reset();
+    try std.testing.expect(!c.choose(other, fallback).hit);
+    try std.testing.expect(!c.choose(l, fallback).hit);
+    c.reset();
+    other = l;
+    other.k = std.math.maxInt(u32);
+    other.n = std.math.maxInt(u32);
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = fallback, .hit = false }, c.choose(other, fallback));
+    try std.testing.expectEqual(@as(usize, 0), c.count);
+    other = l;
+    other.n *= 4;
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = fallback, .hit = false }, c.choose(other, fallback));
+}
+
+test "unpack cache key covers shape and bit width; scale vectors remain outside unpack" {
+    var c: UnpackCache = .{ .base = 0x100000, .capacity = 1 << 20 };
+    var l: weights.Linear = .{ .words = 0x200000, .suh = 1, .svh = 2, .k = 128, .n = 128, .k2 = 6 };
+    _ = c.choose(l, 0);
+    l.suh += 1;
+    l.svh += 1;
+    try std.testing.expect(c.choose(l, 0).hit);
+    l.n *= 2;
+    try std.testing.expect(!c.choose(l, 0).hit);
+    l.k *= 2;
+    try std.testing.expect(!c.choose(l, 0).hit);
+    l.k2 += 1;
+    try std.testing.expect(!c.choose(l, 0).hit);
+    c.reset();
+    for (0..c.entries.len) |i| {
+        l.words = 0x400000 + i * 256;
+        l.k = 128;
+        l.n = 128;
+        try std.testing.expect(c.choose(l, 0).ptr != 0);
+    }
+    l.words = 0x800000;
+    try std.testing.expectEqualDeep(UnpackCache.Choice{ .ptr = 0, .hit = false }, c.choose(l, 0));
+}
+
+test "pair reuse ends before MoE overwrites scratch and never inherits stale entries" {
+    var a: Workspace = .{ .xh = 1, .w = 2, .h = 3 };
+    var b = a; // partner shares ordinary scratch, including its original unpack workspace
+    var r: PairReuse = .{ .enabled = true, .first = &a, .second = &b, .cache = .{ .base = 0x100000, .capacity = 1 << 20 } };
+    const l: weights.Linear = .{ .words = 0x200000, .suh = 1, .svh = 2, .k = 128, .n = 128, .k2 = 6 };
+    try r.begin();
+    try std.testing.expect(!a.cache.?.choose(l, a.w).hit);
+    try std.testing.expect(b.cache.?.choose(l, b.w).hit);
+    r.end();
+    try std.testing.expect(a.cache == null and b.cache == null);
+    try std.testing.expectEqual(@as(usize, 0), r.cache.count);
+    try std.testing.expectEqual(@as(usize, 32768), r.cache.peak_used);
+    // MoE has reused these bytes. A new borrow must unpack again, despite identical addresses and dimensions.
+    try r.begin();
+    try std.testing.expect(!b.cache.?.choose(l, b.w).hit);
+    r.end();
+    r.enabled = false;
+    try r.begin();
+    try std.testing.expect(a.cache == null and b.cache == null);
+    r.end();
+}
+
+test "pair reuse rejects reentrancy and does not clear another owner's workspace" {
+    var a: Workspace = .{ .xh = 1, .w = 2, .h = 3 };
+    var b = a;
+    var r: PairReuse = .{ .enabled = true, .first = &a, .second = &b, .cache = .{ .base = 0x100000, .capacity = 32768 } };
+    var other = r;
+    try other.begin();
+    try std.testing.expectError(error.UnpackCacheAlreadyBound, r.begin());
+    r.end();
+    try std.testing.expect(a.cache == &other.cache and b.cache == &other.cache);
+    other.end();
+    try r.begin();
+    try std.testing.expectError(error.UnpackCacheAlreadyBound, r.begin());
+    r.end();
+    try std.testing.expect(a.cache == null and b.cache == null);
+}
