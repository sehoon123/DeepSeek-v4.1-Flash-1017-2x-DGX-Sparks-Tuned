+/// The drafter pass prefetches its blocks' weights into L2 like the target's layers (+0.37 % decode at one stream, three
+/// reps each, 9 of 11 prompts faster and none slower); TF_DS_DRAFT_PF=0 turns it off.
+fn draftPrefetchWanted() bool {
+    const v = std.c.getenv("TF_DS_DRAFT_PF") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+/// The bytes one of the pass's prefetches may touch into L2: `default`, or `name` in MiB (0 to 64; 0: none there).
+fn dpfBudget(name: [*:0]const u8, default: u64) u64 {
+    const v = std.c.getenv(name) orelse return default;
+    const m = std.fmt.parseInt(u64, std.mem.span(v), 10) catch return default;
+    return if (m > 64) default else m << 20;
+}
+
+/// A linear layer's trellis words (round.zig's linearBytes).
+fn lb(l: weights.Linear) [2]u64 {
+    return .{ l.words, @as(u64, l.k) * l.n * l.k2 / 16 };
+}
+
+/// An mHC mix's weights hc_*_fn: fp32 [24, hc * d].
+fn hcFnBytes(c: anytype) u64 {
+    return 24 * @as(u64, c.hc) * c.hidden * 4;
+}
+
+/// A block's attention mix and input linears, in the order the block reads them.
+fn blockIn(lay: weights.Layer, c: anytype) [4][2]u64 {
