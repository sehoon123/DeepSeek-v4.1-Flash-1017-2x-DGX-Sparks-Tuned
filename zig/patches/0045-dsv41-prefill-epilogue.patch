@@ -148,20 +148,138 @@ pub const gemm_bn = 128;
 /// The prompt GEMM's output dtype: the caller's out tensor's.
 pub const OutType = enum { bf16, fp32 };
 
-/// prefill.matmul's _gemm after the extension's rot_in (xh fp16 [M, K]) and unpack (wq fp16 [K, N]): out [M, N] (row stride os) = (xh wq) H SCALE svh + bias.
+pub const Ep32Shape = struct { k: usize, n: usize, out_type: OutType, min_rows: usize = 129 };
+/// Captured projections only; the 512x128 projection did not benefit. The
+/// smaller column grids use only full chunks: their short-row tests were slower.
+pub const ep32_shapes = [_]Ep32Shape{
+    .{ .k = 5120, .n = 1280, .out_type = .bf16, .min_rows = 2048 },
+    .{ .k = 5120, .n = 512, .out_type = .bf16, .min_rows = 2048 },
+    .{ .k = 4096, .n = 1024, .out_type = .bf16, .min_rows = 2048 },
+    .{ .k = 1280, .n = 16384, .out_type = .bf16 },
+    .{ .k = 3072, .n = 25600, .out_type = .fp32, .min_rows = 512 },
+    .{ .k = 5120, .n = 512, .out_type = .fp32, .min_rows = 2048 },
+    .{ .k = 1280, .n = 4096, .out_type = .bf16 },
+    .{ .k = 4096, .n = 5120, .out_type = .fp32 },
+};
+
+pub fn parsePrefillEp32(value: ?[]const u8) !bool {
+    const s = value orelse return false;
+    if (s.len == 0 or std.mem.eql(u8, s, "0")) return false;
+    if (std.mem.eql(u8, s, "1")) return true;
+    return error.BadPrefillEp32;
+}
+
+pub fn usePrefillEp32(enabled: bool, m: usize, k: usize, n: usize, out_type: OutType, has_bias: bool) bool {
+    if (!enabled or has_bias or m <= 128 or m > 2048) return false;
+    for (ep32_shapes) |s| if (s.k == k and s.n == n and s.out_type == out_type) return m >= s.min_rows;
+    return false;
+}
+
+const GemmLaunch = struct {
+    name: []const u8,
+    grid: [3]u32,
+    args: [8]aot.Arg,
+    consts: [8]aot.Const,
+    nconsts: usize,
+};
+
+inline fn gemmLaunch(enabled: bool, xh: u64, wq: u64, h: u64, svh: u64, bias: ?u64, out: u64, out_type: OutType, os: usize, m: usize, k: usize, n: usize) GemmLaunch {
+    // The input GEMM and grid remain BM128/BK32/GROUP8. Only independent rows
+    // of its original two-term BF16 Hadamard epilogue are partitioned by EP32.
+    const ep32 = usePrefillEp32(enabled, m, k, n, out_type, bias != null);
+    const ty: []const u8 = if (out_type == .bf16) "*bf16" else "*fp32";
+    return .{
+        .name = if (ep32) "_gemm_ep32r128" else "_gemm",
+        .grid = .{ tri.cdiv(m, 128) * u(n / gemm_bn), 1, 1 },
+        .args = .{
+            p("X", "*fp16", xh),                 p("W", "*fp16", wq), p("H", "*bf16", h), p("SVH", "*fp16", svh),
+            p("BIAS", "*fp16", bias orelse svh), p("OUT", ty, out),   int("M", m),        int("o_stride", os),
+        },
+        .consts = .{ ci("K", k), ci("N", n), ci("BM", 128), ci("BK", 32), ci("GROUP", 8), ci("HAS_BIAS", @intFromBool(bias != null)), aot.cf("SCALE", had_scale), ci("EP", 32) },
+        .nconsts = if (ep32) 8 else 7,
+    };
+}
+
+/// Fail at initialization, not the first long request, if an opted-in pack is
+/// incomplete. Uses exactly the runtime launch descriptor, with no GPU launch,
+/// extra allocation, or default-path dependency on the optional variants.
+pub fn requirePrefillEp32(set: anytype) !void {
+    for (ep32_shapes) |s| {
+        const g = gemmLaunch(true, 0x1000, 0x2000, 0x3000, 0x4000, null, 0x5000, s.out_type, s.n, 2048, s.k, s.n);
+        _ = try set.find(g.name, &g.args, g.consts[0..g.nconsts]);
+    }
+}
+
+/// prefill.matmul's _gemm after the extension's rot_in and unpack: the original
+/// arithmetic, weights and output layout; opt-in epilogues share its K step/grid.
 pub fn matmul(t: Tri, xh: u64, wq: u64, h: u64, svh: u64, bias: ?u64, out: u64, out_type: OutType, os: usize, m: usize, k: usize, n: usize) !void {
-    // TF_EXL3_PREFILL_TILES unset in the served lane: tiles() is 128 rows, a 32-wide K step, 8 warps, 4 stages and groups of 8 for every shape
-    const bm = 128;
-    const bk = 32;
-    const group = 8;
-    const ty: []const u8 = switch (out_type) {
-        .bf16 => "*bf16",
-        .fp32 => "*fp32",
+    const g = gemmLaunch(t.prefill_ep32, xh, wq, h, svh, bias, out, out_type, os, m, k, n);
+    try t.run(g.name, g.grid, &g.args, g.consts[0..g.nconsts]);
+}
