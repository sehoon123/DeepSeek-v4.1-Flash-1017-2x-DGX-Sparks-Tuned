+test "prefill epilogue profile defaults and bounded shape selection" {
+    try std.testing.expect(!try parsePrefillEp32(null));
+    try std.testing.expect(!try parsePrefillEp32(""));
+    try std.testing.expect(!try parsePrefillEp32("0"));
+    try std.testing.expect(try parsePrefillEp32("1"));
+    try std.testing.expectError(error.BadPrefillEp32, parsePrefillEp32("2"));
+    try std.testing.expectError(error.BadPrefillEp32, parsePrefillEp32("true"));
+    for (ep32_shapes) |s| {
+        for ([_]usize{ 129, 511, 512, 1537, 2047, 2048 }) |m| {
+            try std.testing.expectEqual(m >= s.min_rows, usePrefillEp32(true, m, s.k, s.n, s.out_type, false));
+            try std.testing.expect(!usePrefillEp32(false, m, s.k, s.n, s.out_type, false));
+            try std.testing.expect(!usePrefillEp32(true, m, s.k, s.n, s.out_type, true));
+        }
+        for ([_]usize{ 0, 1, 48, 128, 2049, 4096 }) |m| try std.testing.expect(!usePrefillEp32(true, m, s.k, s.n, s.out_type, false));
+    }
+    try std.testing.expect(!usePrefillEp32(true, 2048, 512, 128, .bf16, false));
+    try std.testing.expect(!usePrefillEp32(true, 2048, 1280, 16384, .fp32, false));
+    try std.testing.expect(!usePrefillEp32(true, 2048, 5120, 1024, .bf16, false));
+}
+
+test "prefill epilogue leaves grid, runtime arguments and original constants unchanged" {
+    var old: tri.Log = .{ .gpa = std.testing.allocator };
+    defer old.deinit();
+    var next: tri.Log = .{ .gpa = std.testing.allocator };
+    defer next.deinit();
+    try matmul(.{ .log = &old }, 0x1000, 0x2000, 0x3000, 0x4000, null, 0x5000, .fp32, 528, 2048, 5120, 512);
+    try matmul(.{ .log = &next, .prefill_ep32 = true }, 0x1000, 0x2000, 0x3000, 0x4000, null, 0x5000, .fp32, 528, 2048, 5120, 512);
+    const a = old.items.items[0];
+    const b = next.items.items[0];
+    try std.testing.expectEqualStrings("_gemm", a.name);
+    try std.testing.expectEqualStrings("_gemm_ep32r128", b.name);
+    try std.testing.expectEqual([3]u32{ 64, 1, 1 }, a.grid);
+    try std.testing.expectEqual(a.grid, b.grid);
+    try std.testing.expectEqualDeep(a.args, b.args);
+    try std.testing.expectEqualDeep(a.consts, b.consts[0..7]);
+    try std.testing.expectEqualDeep(ci("EP", 32), b.consts[7]);
+}
+
+test "prefill epilogue checks every required AOT signature without launching" {
+    const FakeSet = struct {
+        seen: usize = 0,
+        missing: ?usize = null,
+        fn find(self: *@This(), name: []const u8, args: []const aot.Arg, consts: []const aot.Const) !void {
+            if (self.missing) |i| if (i == self.seen) return error.MissingTritonVariant;
+            try std.testing.expectEqualStrings("_gemm_ep32r128", name);
+            try std.testing.expectEqual(@as(usize, 8), args.len);
+            try std.testing.expectEqual(@as(usize, 8), consts.len);
+            const s = ep32_shapes[self.seen];
+            try std.testing.expectEqualDeep(ci("K", s.k), consts[0]);
+            try std.testing.expectEqualDeep(ci("N", s.n), consts[1]);
+            try std.testing.expectEqualDeep(ci("EP", 32), consts[7]);
+            try std.testing.expectEqualStrings(if (s.out_type == .bf16) "*bf16" else "*fp32", args[5].value.ptr.ty);
+            self.seen += 1;
+        }
     };
-    try t.run("_gemm", .{ tri.cdiv(m, bm) * u(n / gemm_bn), 1, 1 }, &.{
-        p("X", "*fp16", xh),                 p("W", "*fp16", wq), p("H", "*bf16", h), p("SVH", "*fp16", svh),
-        p("BIAS", "*fp16", bias orelse svh), p("OUT", ty, out),   int("M", m),        int("o_stride", os),
-    }, &.{ ci("K", k), ci("N", n), ci("BM", bm), ci("BK", bk), ci("GROUP", group), ci("HAS_BIAS", @intFromBool(bias != null)), aot.cf("SCALE", had_scale) });
+    var complete: FakeSet = .{};
+    try requirePrefillEp32(&complete);
+    try std.testing.expectEqual(ep32_shapes.len, complete.seen);
+    for (0..ep32_shapes.len) |i| {
+        var partial: FakeSet = .{ .missing = i };
+        try std.testing.expectError(error.MissingTritonVariant, requirePrefillEp32(&partial));
+        try std.testing.expectEqual(i, partial.seen);
