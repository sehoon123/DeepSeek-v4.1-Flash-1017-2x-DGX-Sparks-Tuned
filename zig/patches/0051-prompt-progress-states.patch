+/// TF_DS_PROMPT_PROGRESS_TOKENS (prompt_cache Rules.progress_gap; a TF_DS_* name, so the recipe passes it to the ranks): a
+/// long prompt pass also keeps a rolling state every this many tokens, rounded down to the family's chunk ends, at least
+/// four chunks; unset, 0 or not a number: off.
+fn progressGap(text: ?[]const u8, rows: u32) u32 {
+    const n = (envNumber(text) catch return 0) orelse return 0;
+    if (rows == 0 or n < 4 * rows) return 0;
+    return n / rows * rows;
+}
