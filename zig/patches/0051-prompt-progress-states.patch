+/// A prompt pass as a lane host runs one: a lookup, the entry it resumes, a keep at each mark (Lookup.progress ones as
+/// rolling progress states), stopping before token `stop` (an interrupted pass: null). A whole pass returns the sum a
+/// fresh pass gives.
+fn progressPass(f: *Fake, s: *Store, a: Allocator, prompt: []const u32, history_len: u32, shared: []const u32, stop: ?usize) !?u64 {
+    const l = try s.lookup(a, prompt, history_len, shared, &.{});
+    var from: u32 = 0;
+    f.at = 0;
+    f.sum = 0;
+    if (l.entry) |e| {
+        try Fake.restoreFn(f, null, e.saved);
+        s.resumed(e, prompt, true);
+        from = e.at;
+    }
+    for (prompt[from..]) |t| {
+        if (stop) |n| if (f.at >= n) return null;
+        f.sum = f.sum *% 31 +% t;
+        f.at += 1;
+        if (std.mem.indexOfScalar(u32, l.marks, f.at) != null)
+            _ = s.keepAs(prompt, f.at, null, &.{}, std.mem.indexOfScalar(u32, l.progress, f.at) != null);
+    }
+    return f.sum;
+}
+
+fn ramp(comptime n: usize, seed: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = @intCast((i * 7 + seed) % 97);
+    return out;
+}
