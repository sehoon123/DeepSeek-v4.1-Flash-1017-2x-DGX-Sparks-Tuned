--- a/zig/src/families/dsv41/prompt.zig
+++ b/zig/src/families/dsv41/prompt.zig
@@ -1388,6 +1388,50 @@ fn lap(e: *const Engine, eh: *const EngramHost, t: *u64) u64 {
 /// ~0.5 s on one GB10): batches of a quarter of the ring's slots (two reads a row), all submitted (a submit reaps while the
 /// ring is full), then waited for in order.
 fn aioGather(aio: *engram_aio.Aio, t: engram_io.Table, ids: []const i64, out_w: []u8, out_s: []u8) !void {
+    if (ids.len < 64 or !dedupOn()) return aioGatherAll(aio, t, ids, out_w, out_s);
+    // TF_DS_ENGRAM_DEDUP: each row the chunk names read once (a third to a half of a chunk's ids name a row named
+    // before in it), then copied to every place that names it: the same bytes in the same places
+    const gpa = aio.gpa;
+    var first: std.AutoHashMapUnmanaged(i64, u32) = .empty;
+    defer first.deinit(gpa);
+    try first.ensureTotalCapacity(gpa, @intCast(ids.len));
+    const slot_of = try gpa.alloc(u32, ids.len);
+    defer gpa.free(slot_of);
+    var uniq: std.ArrayList(i64) = .empty;
+    defer uniq.deinit(gpa);
+    try uniq.ensureTotalCapacity(gpa, ids.len);
+    for (ids, slot_of) |id, *sl| {
+        const gop = first.getOrPutAssumeCapacity(id);
+        if (!gop.found_existing) {
+            gop.value_ptr.* = @intCast(uniq.items.len);
+            uniq.appendAssumeCapacity(id);
+        }
+        sl.* = gop.value_ptr.*;
+    }
+    const u = uniq.items.len;
+    if (u == ids.len) return aioGatherAll(aio, t, ids, out_w, out_s);
+    const uw = try gpa.alloc(u8, u * t.row_w);
+    defer gpa.free(uw);
+    const us = try gpa.alloc(u8, u * t.row_s);
+    defer gpa.free(us);
+    try aioGatherAll(aio, t, uniq.items, uw, us);
+    if (std.c.getenv("TF_DS_ENGRAM_CACHE_LOG") != null) if (engram_aio.cacheStats()) |st|
+        std.log.info("engram rows: {d} named, {d} distinct; cache {d} found, {d} read, {d} held", .{ ids.len, u, st[0], st[1], st[2] });
+    for (slot_of, 0..) |sl, i| {
+        const at: usize = sl;
+        @memcpy(out_w[i * t.row_w ..][0..t.row_w], uw[at * t.row_w ..][0..t.row_w]);
+        @memcpy(out_s[i * t.row_s ..][0..t.row_s], us[at * t.row_s ..][0..t.row_s]);
+    }
