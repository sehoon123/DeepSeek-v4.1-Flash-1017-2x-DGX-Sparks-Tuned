 /// round's rows (TF_DS_ROUND_ROWS) and the window rings' RING_EXTRA (48 here, the target's and the drafter's) bound it.
 pub const max_window = 48;
 
+/// TF_DS_COPY_SELF_CAP=N (1 to 47; unset: no cap): a sampling stream's copy windows over its own reply at most N tokens.
+fn copySelfCap() u32 {
+    const v = std.c.getenv("TF_DS_COPY_SELF_CAP") orelse return 0;
+    const x = std.fmt.parseInt(u32, std.mem.span(v), 10) catch return 0;
+    return if (x < 1 or x > 47) 0 else x;
+}
+
 /// The image rows a fill_images frame carries at most.
 pub const image_piece = 32 << 10;
 
