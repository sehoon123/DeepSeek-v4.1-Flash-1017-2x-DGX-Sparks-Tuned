diff --git a/zig/src/core/lanes/windows.zig b/zig/src/core/lanes/windows.zig
index a76e4ed..005b6a8 100644
--- a/zig/src/core/lanes/windows.zig
+++ b/zig/src/core/lanes/windows.zig
@@ -137,6 +137,11 @@ pub fn copyProposal(e: *Engine, s: *Stream) ![]const u32 {
     const width: u32 = if (e.alone) (s.copy_width orelse e.cfg.first_copy) else e.cfg.first_copy;
     const copied = p.propose(s.context.items, @min(@as(i64, width), s.draftRoom() - 1)) catch return &.{};
     if (copied.len < 2 or p.lastMatch() < e.cfg.enter_match) return &.{};
+    // Config.copy_self_cap (this recipe): a sampling stream's copy of its own reply, not of its prompt, at most this many
+    // tokens: a reply repeating itself at temperature > 0 leaves the copy sooner than one copying its prompt does
+    if (e.cfg.copy_self_cap > 0) if (s.sampling) |sm| if (sm.temperature > 0) if (p.lastFrom()) |from| {
+        if (from >= @as(i64, @intCast(s.prompt_len)) and copied.len > e.cfg.copy_self_cap) return copied[0..e.cfg.copy_self_cap];
+    };
     return copied;
 }
 
