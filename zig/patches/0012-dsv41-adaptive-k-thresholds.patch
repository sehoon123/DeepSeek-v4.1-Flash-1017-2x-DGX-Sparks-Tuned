diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index 456aa07..86578e0 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -302,6 +302,8 @@ pub const Lanes = struct {
     conf_bias: f64 = 0, // TF_DS_CONF_BIAS: add to every confidence logit before its sigmoid
     adapt_k: bool = false, // TF_DS_ADAPT_K: probe K5 and keep it only while its observed acceptance supports it
     adapt_period: usize = 8,
+    adapt_accept: usize = 4, // accepted drafts a K5 observation needs to raise/hold K5
+    adapt_max_live: usize = 2, // above this concurrency K3 is the measured exact/fast policy
     policy_log: bool = false,
     drawn: [ring]u32 = undefined,
     next: u64 = 0,
@@ -671,8 +673,8 @@ pub const Lanes = struct {
             l.proposed[proposed] += 1;
             l.accepted[proposed] += accepted;
             l.policy_rounds += 1;
-            if (self.adapt_k and proposed >= 4) {
-                if (accepted >= 4) l.policy_score = @min(8, l.policy_score + 2)
+            if (self.adapt_k and self.streams.count() <= self.adapt_max_live and proposed >= 4) {
+                if (accepted >= self.adapt_accept) l.policy_score = @min(8, l.policy_score + 2)
                 else l.policy_score = @max(-4, l.policy_score - 2);
                 if (l.policy_score >= 4) l.policy_k = 5;
                 if (l.policy_score <= 0) l.policy_k = 3;
@@ -750,8 +752,9 @@ pub const Lanes = struct {
             return true;
         }
         if (self.adapt_k) {
-            const probe = l.policy_k == 3 and l.policy_rounds % self.adapt_period == self.adapt_period - 1;
-            const k = if (probe) @as(usize, 5) else l.policy_k;
+            const crowded = self.streams.count() > self.adapt_max_live;
+            const probe = !crowded and l.policy_k == 3 and l.policy_rounds % self.adapt_period == self.adapt_period - 1;
+            const k = if (crowded) @as(usize, 3) else if (probe) @as(usize, 5) else l.policy_k;
             for (out, 0..) |*o, j| o.* = if (j < k) 1.0 else 0.0;
             return true;
         }
diff --git a/zig/src/families/dsv41/native.zig b/zig/src/families/dsv41/native.zig
index 28bd121..d25bab6 100644
--- a/zig/src/families/dsv41/native.zig
+++ b/zig/src/families/dsv41/native.zig
@@ -156,6 +156,14 @@ pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
         st.lanes.adapt_period = std.fmt.parseInt(usize, t, 10) catch return error.BadFixK;
         if (st.lanes.adapt_period < 2 or st.lanes.adapt_period > 64) return error.BadFixK;
     }
+    if (getenv("TF_DS_ADAPT_ACCEPT")) |t| {
+        st.lanes.adapt_accept = std.fmt.parseInt(usize, t, 10) catch return error.BadFixK;
+        if (st.lanes.adapt_accept < 1 or st.lanes.adapt_accept > 5) return error.BadFixK;
+    }
+    if (getenv("TF_DS_ADAPT_MAX_LIVE")) |t| {
+        st.lanes.adapt_max_live = std.fmt.parseInt(usize, t, 10) catch return error.BadFixK;
+        if (st.lanes.adapt_max_live < 1 or st.lanes.adapt_max_live > 4) return error.BadFixK;
+    }
     if (getenv("TF_DS_POLICY_LOG")) |t| st.lanes.policy_log = std.mem.eql(u8, t, "1");
     // a vision checkpoint's tower on this rank, from the kit's vision/ (torch's attention cubin, the routing bias)
     st.vision = null;
