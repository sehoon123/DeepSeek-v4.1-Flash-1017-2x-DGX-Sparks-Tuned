+    try std.testing.expectEqual(@as(usize, 1), seen.tokens); // with the first token committed
+    try std.testing.expect(target.draft_calls > 0); // and that pass still asked, after it
+    while (engine.activeCount() > 0) try engine.step();
+    try std.testing.expectEqual(@as(usize, 1), seen.calls); // once a stream
