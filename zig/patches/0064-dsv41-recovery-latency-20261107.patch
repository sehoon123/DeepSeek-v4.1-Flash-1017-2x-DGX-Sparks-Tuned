+test "bundle14: a drafter pass that fails on a failed RDMA ring ends the process too" {
+    const keep = broken;
+    defer broken = keep;
+    broken = sawBroken;
+    var r: rdma.Ring = undefined;
+    r.failed = .init(true);
+    r.why = @splat(0);
+    @memcpy(r.why[0.."completion queue error".len], "completion queue error");
+    var m: Model = undefined;
+    m.ring = &r;
+    m.dr = null; // no drafter here: the pass fails before it touches the GPU
+    var lanes_: Lanes = undefined;
+    lanes_.m = &m;
+    broken_seen = null;
+    try std.testing.expectError(error.NoDraftHead, Lanes.draftFn(&lanes_, &.{}));
+    try std.testing.expect(broken_seen != null);
+    try std.testing.expectEqualStrings("completion queue error", broken_seen.?);
+    r.failed.store(false, .release);
+    broken_seen = null;
+    try std.testing.expectError(error.NoDraftHead, Lanes.draftFn(&lanes_, &.{})); // a sound ring: the error only
+    try std.testing.expect(broken_seen == null);
+}
