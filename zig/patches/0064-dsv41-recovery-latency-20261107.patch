+test "bundle14: a stream's first token goes to the host before its first drafts are asked" {
+    var cfg = try model();
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer engine.deinit();
+    const Seen = struct {
+        target: *fake.Fake,
+        calls: usize = 0,
+        drafts_before: usize = 0,
+        tokens: usize = 0,
+        fn run(ptr: *anyopaque, s: *sm.Stream) void {
+            const seen: *@This() = @ptrCast(@alignCast(ptr));
+            seen.calls += 1;
+            seen.drafts_before = seen.target.draft_calls;
+            seen.tokens = s.emitted().len;
+        }
+    };
+    var seen: Seen = .{ .target = &target };
+    const prompt = [_]u32{ 11, 12, 13, 14, 15, 16, 17, 18 };
+    var s = try sm.Stream.init(gpa, .{ .id = "first", .prompt = &prompt, .max_new = 8 });
+    defer s.deinit(gpa);
+    s.first = .{ .ptr = &seen, .run = Seen.run };
+    try engine.addStream(&s);
