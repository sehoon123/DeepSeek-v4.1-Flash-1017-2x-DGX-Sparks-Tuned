+test "bundle14: a write to a client that stopped reading gives up after write_ms" {
+    // (the write before bundle 14 blocked here until the other end closed; that is a SIGPIPE in a test, so ignore it)
+    const ignore: posix.Sigaction = .{ .handler = .{ .handler = posix.SIG.IGN }, .mask = posix.sigemptyset(), .flags = 0 };
+    var was: posix.Sigaction = undefined;
+    posix.sigaction(.PIPE, &ignore, &was);
+    defer posix.sigaction(.PIPE, &was, null);
+    var pair: [2]std.c.fd_t = undefined;
+    try std.testing.expectEqual(@as(c_int, 0), std.c.socketpair(posix.AF.UNIX, posix.SOCK.STREAM, 0, &pair));
+    defer _ = std.c.close(pair[0]);
+    var c = try Conn.init(std.testing.allocator, pair[0], "test");
+    defer c.deinit();
+    c.timeouts.write_ms = 200;
+    const data = try std.testing.allocator.alloc(u8, 4 << 20);
+    defer std.testing.allocator.free(data);
+    @memset(data, 'x');
+    const W = struct {
+        fn run(conn: *Conn, d: []const u8, out: *std.atomic.Value(u8)) void {
+            conn.writeAll(d) catch {
+                out.store(2, .release);
+                return;
+            };
+            out.store(1, .release);
+        }
+    };
+    var out = std.atomic.Value(u8).init(0);
+    const t = try std.Thread.spawn(.{}, W.run, .{ &c, data, &out });
+    var waited: usize = 0;
+    while (out.load(.acquire) == 0 and waited < 2000) : (waited += 10) std.Io.sleep(std.testing.io, .fromMilliseconds(10), .awake) catch {};
+    const gave_up_in_time = out.load(.acquire) == 2;
+    _ = std.c.close(pair[1]); // (ends a write still blocked)
+    t.join();
+    try std.testing.expect(gave_up_in_time);
+}
+
+test "bundle14: a peer that sent a byte and closed is gone" {
+    var pair: [2]std.c.fd_t = undefined;
+    try std.testing.expectEqual(@as(c_int, 0), std.c.socketpair(posix.AF.UNIX, posix.SOCK.STREAM, 0, &pair));
+    defer _ = std.c.close(pair[0]);
+    var c = try Conn.init(std.testing.allocator, pair[0], "test");
+    defer c.deinit();
+    try std.testing.expect(!c.peerGone()); // nothing yet: here
+    try std.testing.expectEqual(@as(isize, 1), std.c.write(pair[1], "x", 1));
+    try std.testing.expect(!c.peerGone()); // a pipelined byte: still here
+    _ = std.c.close(pair[1]);
+    try std.testing.expect(c.peerGone());
+}
