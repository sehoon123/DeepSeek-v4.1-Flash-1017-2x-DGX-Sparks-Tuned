+/// A 1 x 1 GIF (GIF89a, one white pixel) and a 1 x 1 JPEG (white, Pillow 12.3's quality 95).
+const gif_1x1 = "GIF89a\x01\x00\x01\x00\x80\x00\x00\xff\xff\xff\x00\x00\x00!\xf9\x04\x01\x00\x00\x00\x00,\x00\x00\x00\x00\x01\x00\x01\x00\x00\x02\x02D\x01\x00;";
+const jpeg_1x1_b64 = "";
+
+test "bundle13: every picture is checked at its declared size before its decode" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const jpeg = try a.alloc(u8, try std.base64.standard.Decoder.calcSizeForSlice(jpeg_1x1_b64));
+    try std.base64.standard.Decoder.decode(jpeg, jpeg_1x1_b64);
+    // no reserve (whatever this machine has free): both decode
+    const fed = try std.mem.replaceOwned(u8, a, script, "RESERVE = 5637144576", "RESERVE = 0");
+    try std.testing.expect(!std.mem.eql(u8, fed, script));
+    const p = Pil.startWith(gpa, io, fed, deadline_ms) catch |e| {
+        std.debug.print("no python3 with Pillow here ({s})\n", .{@errorName(e)});
+        return error.SkipZigTest;
+    };
+    defer p.stop(gpa);
+    for ([_][]const u8{ gif_1x1, jpeg }) |pic| switch (try p.decode(a, pic)) {
+        .rgb => |rgb| try std.testing.expectEqualSlices(u8, &.{ 255, 255, 255 }, rgb.px),
+        .refused => |why| {
+            std.debug.print("refused: {s}\n", .{why});
+            return error.TestUnexpectedResult;
+        },
+    };
+    // a reserve no machine has: both are refused, in the words vision.zig refuses with, and the child goes on (the wrapper
+    // of Pillow's own size checks made to pass, so each refusal is the check before the decode; fixtures/wrapper_check.py
+    // tests the wrapper)
+    const hungry_all = try std.mem.replaceOwned(u8, a, script, "RESERVE = 5637144576", "RESERVE = 1 << 62");
+    const hungry = try std.mem.replaceOwned(u8, a, hungry_all, "size[1] * 16 + RESERVE", "size[1] * 0");
+    try std.testing.expect(!std.mem.eql(u8, hungry, hungry_all));
+    const q = try Pil.startWith(gpa, io, hungry, deadline_ms);
+    defer q.stop(gpa);
+    for ([_][]const u8{ gif_1x1, jpeg, gif_1x1 }) |pic| switch (try q.decode(a, pic)) {
+        .rgb => return error.TestUnexpectedResult,
+        .refused => |why| try std.testing.expectEqualStrings("image input: the server is short of memory for this picture right now; retry in a minute, or send a smaller image", why),
+    };
+}
