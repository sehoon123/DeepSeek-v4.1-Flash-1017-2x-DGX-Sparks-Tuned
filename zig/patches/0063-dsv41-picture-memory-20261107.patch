-    if (data.len < 24 or !std.mem.eql(u8, data[0..8], "\x89PNG\r\n\x1a\n")) return null;
+    if (data.len < 24 or !std.mem.eql(u8, data[0..8], "\x89PNG\r\n\x1a\n") or !std.mem.eql(u8, data[12..16], "IHDR")) return null;
     return @as(usize, std.mem.readInt(u32, data[16..20], .big)) * std.mem.readInt(u32, data[20..24], .big);
 }
 
@@ -193,6 +193,9 @@ pub fn decodePng(a: Allocator, data: []const u8) Error!Rgb {
         hc.update(kind);
         hc.update(body);
         if (hc.final() != crc) return error.BadPng;
+        // (bundle 13, review ab4acaf8) IHDR first and once: vision.zig checks the room for the first chunk's size, and
+        // a later IHDR decoded at a size nobody checked; such a PNG is Pillow's (its last IHDR before IDAT, checked there)
+        if ((at == 8) != std.mem.eql(u8, kind, "IHDR")) return error.BadPng;
         at += 12 + len;
