@@ -650,6 +653,46 @@ test "a span's token types" {
     try std.testing.expectEqualSlices(Type, &.{ .start, .image, .image, .image, .newline, .image, .image, .image, .newline, .end }, &t);
 }
 
+fn testChunk(out: *std.ArrayList(u8), a: Allocator, kind: *const [4]u8, body: []const u8) !void {
+    var len: [4]u8 = undefined;
+    std.mem.writeInt(u32, &len, @intCast(body.len), .big);
+    try out.appendSlice(a, &len);
+    try out.appendSlice(a, kind);
+    try out.appendSlice(a, body);
+    var hc = std.hash.Crc32.init();
+    hc.update(kind);
+    hc.update(body);
+    var crc: [4]u8 = undefined;
+    std.mem.writeInt(u32, &crc, hc.final(), .big);
+    try out.appendSlice(a, &crc);
+}
+
+test "bundle13: a PNG's IHDR comes first and once, else the PNG is Pillow's" {
+    const a = std.testing.allocator;
+    // 1 x 1 8-bit RGB, one black pixel: IHDR, IDAT (zlib of filter 0 and three zeros), IEND
+    const one = [13]u8{ 0, 0, 0, 1, 0, 0, 0, 1, 8, 2, 0, 0, 0 };
+    const idat = [_]u8{ 0x78, 0x9c, 0x63, 0x60, 0x60, 0x60, 0x00, 0x00, 0x00, 0x04, 0x00, 0x01 };
+    for ([_][]const []const u8{ &.{ "IHDR", "IDAT", "IEND" }, &.{ "IHDR", "IHDR", "IDAT", "IEND" }, &.{ "tEXt", "IHDR", "IDAT", "IEND" }, &.{ "IHDR", "IDAT", "IHDR", "IEND" } }, 0..) |kinds, case| {
+        var png: std.ArrayList(u8) = .empty;
+        defer png.deinit(a);
+        try png.appendSlice(a, signature);
+        // (a second IHDR of the same size: the rule, not the size, is what is under test)
+        for (kinds) |kind| {
+            const body: []const u8 = if (std.mem.eql(u8, kind, "IHDR")) &one else if (std.mem.eql(u8, kind, "IDAT")) &idat else if (std.mem.eql(u8, kind, "tEXt")) "k\x00v" else "";
+            try testChunk(&png, a, kind[0..4], body);
+        }
+        if (case == 0) {
+            var rgb = try decodePng(a, png.items);
+            defer rgb.deinit(a);
+            try std.testing.expectEqualSlices(u8, &.{ 0, 0, 0 }, rgb.px);
+            try std.testing.expectEqual(@as(?usize, 1), pixels(png.items));
+        } else {
+            try std.testing.expectError(error.BadPng, decodePng(a, png.items));
+            if (case == 2) try std.testing.expectEqual(@as(?usize, null), pixels(png.items));
+        }
+    }
+}
