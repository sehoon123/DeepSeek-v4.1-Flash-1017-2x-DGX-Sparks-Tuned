diff --git a/zig/src/families/dsv41/pil.zig b/zig/src/families/dsv41/pil.zig
index 72779da..7c39df4 100644
--- a/zig/src/families/dsv41/pil.zig
+++ b/zig/src/families/dsv41/pil.zig
@@ -18,26 +18,60 @@ pub const deadline_ms: i32 = 110_000;
 /// The child: a request is the image's length (u64 LE) and bytes; the answer a status byte (0: pixels, 1: Pillow's
 /// DecompressionBombError, 2: another error), width, height and the length of what follows (u64 LE each), then the
 /// RGB rows or the error's text. The lane refuses past 134,217,728 pixels: twice Image.MAX_IMAGE_PIXELS.
+/// (bundle 13) Every picture is checked here at the size its header declares, before its decode, above memguard's line
+/// (4.25 GiB) and a 1 GiB margin as vision.zig's roomToDecode checks: 16 bytes a pixel for JPEG, MPO and PNG (that
+/// check's figure), 26 for every other format (this child measured 22.4 for a WebP lossless and 19.2 for a JPEG 2000
+/// at 33.5 Mpx, plus the lane's 3 for the RGB it receives). Before, vision.zig counted a format it reads no header of
+/// as 24 Mpx, and a 134 Mpx JPEG 2000 took 2.9 GiB for about 15 s. Pillow's own size check of every picture it is
+/// about to decode, an embedded one too (ICO while it opens, ICNS, BLP, GIF frames, TIFF tiles), passes the same room
+/// check at 16 bytes a pixel (review a1e38979: an embedded picture of up to 134 Mpx decoded after a check at the
+/// declared size). The picture's objects go before the child waits for the next one (review ab4acaf8: they held up to
+/// 1.5 GB idle).
 pub const script =
     \\import io, struct, sys, warnings
     \\from PIL import Image
     \\warnings.simplefilter("ignore")
     \\Image.MAX_IMAGE_PIXELS = 67108864
+    \\RESERVE = 5637144576
+    \\SHORT = b"the server is short of memory for this picture right now; retry in a minute, or send a smaller image"
     \\inp, out = sys.stdin.buffer, sys.stdout.buffer
+    \\class Short(Exception):
+    \\    pass
     \\def take(n):
     \\    b = inp.read(n)
     \\    if len(b) < n:
     \\        sys.exit(0)
     \\    return b
+    \\def room(need):
+    \\    try:
+    \\        with open("/proc/meminfo", "rb") as f:
+    \\            for line in f:
+    \\                if line.startswith(b"MemAvailable:"):
+    \\                    return int(line.split()[1]) * 1024 >= need
+    \\    except OSError:
+    \\        pass
+    \\    return True
+    \\bomb_check = Image._decompression_bomb_check
+    \\def guarded(size):
+    \\    bomb_check(size)
+    \\    if not room(size[0] * size[1] * 16 + RESERVE):
+    \\        raise Short
+    \\Image._decompression_bomb_check = guarded
     \\out.write(b"PIL" + Image.__version__.encode().ljust(13))
     \\out.flush()
     \\while True:
     \\    data = take(struct.unpack("<Q", take(8))[0])
     \\    try:
     \\        with Image.open(io.BytesIO(data)) as source:
+    \\            per = 16 if source.format in ("JPEG", "MPO", "PNG") else 26
+    \\            if not room(source.width * source.height * per + RESERVE):
+    \\                raise Short
     \\            image = source.convert("RGB")
     \\        px = image.tobytes()
-    \\        out.write(struct.pack("<BQQQ", 0, image.width, image.height, len(px)) + px)
+    \\        out.write(struct.pack("<BQQQ", 0, image.width, image.height, len(px)))
+    \\        out.write(px)
+    \\    except Short:
+    \\        out.write(struct.pack("<BQQQ", 2, 0, 0, len(SHORT)) + SHORT)
     \\    except Image.DecompressionBombError as e:
     \\        m = str(e).encode()
     \\        out.write(struct.pack("<BQQQ", 1, 0, 0, len(m)) + m)
@@ -45,6 +79,7 @@ pub const script =
     \\        m = str(e).encode()
     \\        out.write(struct.pack("<BQQQ", 2, 0, 0, len(m)) + m)
     \\    out.flush()
+    \\    data = source = image = px = None
 ;
 
 pub const Pil = struct {
@@ -192,6 +227,47 @@ const slow_script =
     \\    out.flush()
