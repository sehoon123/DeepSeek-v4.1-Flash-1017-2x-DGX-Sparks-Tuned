+    /// Every kept state the request with this prompt could have kept or resumed (its tokens, lookahead and all, begin
+    /// the prompt): the request's scores turned NaN, and one of them may hold the fault. How many went.
+    pub fn forgetPrefixes(s: *Store, prompt: []const u32) usize {
+        var gone: usize = 0;
+        var i: usize = 0;
+        while (i < s.entries.items.len) {
+            const e = s.entries.items[i];
+            if (e.tokens.len <= prompt.len and std.mem.eql(u32, e.tokens, prompt[0..e.tokens.len])) {
+                s.counts.failed += 1;
+                s.remove(i);
+                gone += 1;
+            } else i += 1;
+        }
+        return gone;
+    }
+
     fn sharedKey(tokens: []const u32) u64 {
         return std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(tokens));
     }
