         try std.testing.expectEqualSlices(u32, plain, gated);
     }
 }
+
+/// (bundle 11) X, y, a filler, then X again, where y is the fake's first token after it: round 1 copies from the prompt.
+fn copiedPrompt(sampling: ?Sampling) ![23]u32 {
+    var p = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, 0, 40, 41, 42, 43, 44, 45, 1, 2, 3, 4, 5, 6, 7, 8 };
+    for (0..fake.vocab) |y| {
+        p[8] = @intCast(y);
+        if (fake.next(&p, sampling, p.len) == y) return p;
+    }
+    return error.NoFirstTokenCopies;
+}
+
+test "bundle11: a stream whose first round copies from its prompt asks the head for no first drafts, and its tokens stay the target's" {
+    const sampled: Sampling = .{ .seed = 5, .temperature = 0.7, .top_k = 0, .top_p = 0.95 };
+    for ([_][]const ?Sampling{ &.{null}, &.{sampled}, &.{ null, sampled } }) |samplings| {
+        var cfg = try model();
+        defer cfg.deinit(gpa);
+        var target: fake.Fake = .{ .gpa = gpa };
+        defer target.deinit();
+        var clock: fake.FixedClock = .{};
+        var engine = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+        defer engine.deinit();
+        var prompts: [2][23]u32 = undefined;
+        var proposers: [2]SuffixLookup = undefined;
+        var streams: [2]sm.Stream = undefined;
+        var made: usize = 0;
+        defer for (streams[0..made], proposers[0..made]) |*s, *p| {
+            s.deinit(gpa);
+            p.deinit();
+        };
+        const n = samplings.len;
+        for (samplings, prompts[0..n], proposers[0..n], streams[0..n]) |sampling, *prompt, *p, *s| {
+            prompt.* = try copiedPrompt(sampling);
+            p.* = try SuffixLookup.init(gpa, .{ .min_match = 4 });
+            s.* = try sm.Stream.init(gpa, .{ .id = "copied", .prompt = prompt, .max_new = 40, .sampling = sampling, .proposer = p.proposer() });
+            made += 1;
+        }
+        for (streams[0..n]) |*s| try engine.addStream(s);
+        while (engine.activeCount() > 0) try engine.step();
+        try std.testing.expect(target.host_windows > 0); // copy windows ran, round 1's among them
+        try std.testing.expectEqual(@as(usize, 0), target.held_dropped);
+        for (samplings, prompts[0..n], streams[0..n]) |sampling, prompt, *s| {
+            var history: std.ArrayList(u32) = .empty;
+            defer history.deinit(gpa);
+            try history.appendSlice(gpa, &prompt);
+            for (s.emitted()) |t| {
+                try std.testing.expectEqual(fake.next(history.items, sampling, history.items.len), t);
+                try history.append(gpa, t);
+            }
+            try std.testing.expectEqual(@as(usize, 40), s.emitted().len);
+        }
+    }
+}
