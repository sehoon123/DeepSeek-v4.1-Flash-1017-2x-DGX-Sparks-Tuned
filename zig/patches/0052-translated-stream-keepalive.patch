+/// Anthropic Messages' own keepalive event (its streams "may include any number of ping events"): transport-only, as
+/// `keepalive`, for clients of that format. No allocation and no model/request data.
+pub fn ping(conn: *Conn) error{Closed}!void {
+    return conn.writeAll("event: ping\ndata: {\"type\":\"ping\"}\n\n");
+}
