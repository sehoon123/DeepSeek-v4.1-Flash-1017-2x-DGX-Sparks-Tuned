+/// ``placed`` with each placeholder put back as its string, and the byte range each string lands at (in order, apart);
+/// null when a placeholder names no string.
+fn restore(a: Allocator, placed: []const u8, originals: []const []const u8, spans: *std.ArrayList([2]usize)) Allocator.Error!?[]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (std.mem.indexOfPos(u8, placed, i, mark_open)) |p| {
+        try out.appendSlice(a, placed[i..p]);
+        const q = std.mem.indexOfPos(u8, placed, p + mark_open.len, mark_close) orelse return null;
+        const k = std.fmt.parseInt(usize, placed[p + mark_open.len .. q], 10) catch return null;
+        if (k >= originals.len) return null;
+        try spans.append(a, .{ out.items.len, out.items.len + originals[k].len });
+        try out.appendSlice(a, originals[k]);
+        i = q + mark_close.len;
+    }
+    try out.appendSlice(a, placed[i..]);
+    return out.items;
+}
