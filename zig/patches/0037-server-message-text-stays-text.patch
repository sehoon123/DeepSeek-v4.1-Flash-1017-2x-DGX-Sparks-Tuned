+/// The placeholder a message's string becomes (markStrings): U+E000, its index, U+E001 (private use characters).
+const mark_open = "\u{E000}";
+const mark_close = "\u{E001}";
+
+/// A copy of ``messages`` in which each string a message carries that holds an added token's text (its content, or
+/// a content part's text; reasoning_content or reasoning; a tool call's arguments, or their string values when they
+/// are an object) is a placeholder; the strings go to ``originals`` in index order. Null when there is none, or when
+/// one of a message's strings holds the placeholder characters itself.
+fn markStrings(a: Allocator, messages: json.Value, originals: *std.ArrayList([]const u8), ctx: *anyopaque, added_in: *const fn (ctx: *anyopaque, text: []const u8) bool) Allocator.Error!?json.Value {
+    if (messages != .array) return null;
+    var m: Marker = .{ .a = a, .originals = originals, .ctx = ctx, .added_in = added_in };
+    const out = try a.alloc(json.Value, messages.array.len);
+    for (messages.array, out) |msg, *o| o.* = try m.message(msg);
+    if (m.clash or originals.items.len == 0) return null;
+    return .{ .array = out };
+}
+
+const Marker = struct {
+    a: Allocator,
+    originals: *std.ArrayList([]const u8),
+    ctx: *anyopaque,
+    added_in: *const fn (ctx: *anyopaque, text: []const u8) bool,
+    clash: bool = false,
+
+    fn str(m: *Marker, v: json.Value) Allocator.Error!json.Value {
+        if (v != .string) return v;
+        if (std.mem.indexOf(u8, v.string, mark_open) != null or std.mem.indexOf(u8, v.string, mark_close) != null) {
+            m.clash = true;
+            return v;
+        }
+        if (!m.added_in(m.ctx, v.string)) return v;
+        try m.originals.append(m.a, v.string);
+        return .{ .string = try std.fmt.allocPrint(m.a, mark_open ++ "{d}" ++ mark_close, .{m.originals.items.len - 1}) };
+    }
+
+    fn copy(m: *Marker, v: json.Value) Allocator.Error!*json.Object {
+        const o = try json.newObject(m.a);
+        var it = v.object.iterator();
+        while (it.next()) |e| try o.put(m.a, e.key_ptr.*, e.value_ptr.*);
+        return o;
+    }
+
+    fn message(m: *Marker, v: json.Value) Allocator.Error!json.Value {
+        if (v != .object) return v;
+        const o = try m.copy(v);
+        if (o.getPtr("content")) |c| switch (c.*) {
+            .string => c.* = try m.str(c.*),
+            .array => |parts| {
+                const out = try m.a.alloc(json.Value, parts.len);
+                for (parts, out) |p, *q| {
+                    q.* = p;
+                    if (p == .object) if (p.object.get("text")) |t| if (t == .string) {
+                        const po = try m.copy(p);
+                        try po.put(m.a, "text", try m.str(t));
+                        q.* = .{ .object = po };
+                    };
+                }
+                c.* = .{ .array = out };
+            },
+            else => {},
+        };
+        for ([_][]const u8{ "reasoning_content", "reasoning" }) |k| if (o.getPtr(k)) |r| {
+            r.* = try m.str(r.*);
+        };
+        if (o.getPtr("tool_calls")) |tc| if (tc.* == .array) {
+            const calls = try m.a.alloc(json.Value, tc.array.len);
+            for (tc.array, calls) |call, *out| {
+                out.* = call;
+                if (call != .object) continue;
+                const co = try m.copy(call);
+                if (co.getPtr("function")) |f| if (f.* == .object) {
+                    const fo = try m.copy(f.*);
+                    if (fo.getPtr("arguments")) |args| switch (args.*) {
+                        .string => args.* = try m.str(args.*),
+                        .object => {
+                            const ao = try m.copy(args.*);
+                            for (ao.values()) |*x| x.* = try m.str(x.*);
+                            args.* = .{ .object = ao };
+                        },
+                        else => {},
+                    };
+                    f.* = .{ .object = fo };
+                };
+                out.* = .{ .object = co };
+            }
+            tc.* = .{ .array = calls };
+        };
+        return .{ .object = o };
+    }
+};
