+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+                .finished => |f| b.done = f.reason,
+                else => {},
+            }
+        }
+        fn doneNow(b: *@This()) ?Reason {
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            return b.done;
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                if (b.doneNow()) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    const e = host.engine();
+    const prompt_a = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4 }; // ten tokens: not nested itself
+    const prompt_b = [_]u32{ 2, 7, 1 }; // three: fills inside A's pass
+    const Watch = struct {
+        engine: Engine,
+        a_stream: ?*lanes.Stream = null,
+        b: *Box,
+        req_b: *const Request,
+        cancel_a: bool,
+        b_done_at_a_last: ?Reason = null,
+        a_chunks: usize = 0,
+        b_chunks: usize = 0,
+        fn call(ctx: *anyopaque, s: *lanes.Stream, chunk: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            if (w.a_stream == null) w.a_stream = s;
+            if (s == w.a_stream) {
+                w.a_chunks += 1;
+                if (chunk == 1) w.engine.submit(2, w.req_b, .{ .ctx = w.b, .event = Box.event }) catch {};
+                if (chunk == 5) w.b_done_at_a_last = w.b.doneNow();
+            } else {
+                w.b_chunks += 1;
+                if (w.cancel_a and chunk == 2) w.engine.cancel(1); // A is suspended in its between: its pass ends it
+            }
+        }
+    };
+    target.prefill_chunks = 6;
+    for ([_]bool{ false, true }) |cancel_a| {
+        var a: Box = .{};
+        defer a.tokens.deinit(gpa);
+        var b: Box = .{};
+        defer b.tokens.deinit(gpa);
+        const req_a: Request = .{ .prompt = &prompt_a, .max_tokens = 3 };
+        const req_b: Request = .{ .prompt = &prompt_b, .max_tokens = 5 };
+        var watch = Watch{ .engine = e, .b = &b, .req_b = &req_b, .cancel_a = cancel_a };
+        target.prefill_hook = Watch.call;
+        target.prefill_hook_ctx = &watch;
+        try e.submit(1, &req_a, .{ .ctx = &a, .event = Box.event });
+        try std.testing.expectEqual(Reason.length, b.wait());
+        try std.testing.expectEqual(if (cancel_a) Reason.cancelled else Reason.length, a.wait());
+        try std.testing.expectEqual(@as(usize, 6), watch.b_chunks); // B's whole pass
+        if (!cancel_a) {
+            // B ended while A's pass was still running (its last chunk saw B done), and both decoded their own tokens
+            try std.testing.expectEqual(@as(?Reason, Reason.length), watch.b_done_at_a_last);
+            try std.testing.expectEqual(@as(usize, 6), watch.a_chunks);
+            for ([_]*Box{ &a, &b }, [_][]const u32{ &prompt_a, &prompt_b }) |box, prompt| {
+                var history: std.ArrayList(u32) = .empty;
+                defer history.deinit(gpa);
+                try history.appendSlice(gpa, prompt);
+                for (box.tokens.items) |t| {
+                    try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+                    try history.append(gpa, t);
+                }
+            }
+        } else try std.testing.expect(watch.a_chunks <= 3); // A's pass saw its cancel at its next chunk
+        while (target.lanes.count() > 0) std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+}
