+/// `text` read as unicode.appendLossy reads it (each maximal invalid subpart a U+FFFD), and `spans` (byte ranges of
+/// `text`) at the new text's offsets: a range's ends move with the bytes before them.
+fn lossyWithSpans(a: Allocator, text: []const u8, spans: []const [2]usize) Allocator.Error!struct { text: []const u8, spans: []const [2]usize } {
+    var out: std.ArrayList(u8) = .empty;
+    const at = try a.alloc(usize, text.len + 1); // the new offset of each byte of `text` (and of its end)
+    var i: usize = 0;
+    while (i < text.len) {
+        const step = unicode.scan(text, i);
+        for (0..step.len) |k| at[i + k] = out.items.len;
+        if (step.cp == null) try out.appendSlice(a, "\u{FFFD}") else try out.appendSlice(a, text[i .. i + step.len]);
+        i += step.len;
+    }
+    at[text.len] = out.items.len;
+    const moved = try a.alloc([2]usize, spans.len);
+    for (spans, moved) |sp, *m| m.* = .{ at[sp[0]], at[sp[1]] };
+    return .{ .text = out.items, .spans = moved };
+}
+
+test "bug hunt: a text that is not UTF-8 keeps its spans' offsets when read lossily" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    // "x" + a lone surrogate (3 invalid bytes: 3 U+FFFD) + " ab" with the span over "ab"
+    const text = "x\xED\xA0\x80 ab";
+    const got = try lossyWithSpans(a, text, &.{.{ 5, 7 }});
+    var lossy: std.ArrayList(u8) = .empty;
+    try unicode.appendLossy(&lossy, a, text);
+    try std.testing.expectEqualStrings(lossy.items, got.text); // the text encode reads
+    try std.testing.expectEqualStrings("ab", got.text[got.spans[0][0]..got.spans[0][1]]);
+    try std.testing.expect(std.unicode.utf8ValidateSlice(got.text));
+}
