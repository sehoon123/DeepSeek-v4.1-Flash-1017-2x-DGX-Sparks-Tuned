diff --git a/zig/src/families/dsv41/phase_arena.zig b/zig/src/families/dsv41/phase_arena.zig
new file mode 100644
index 0000000..ca428be
--- /dev/null
+++ b/zig/src/families/dsv41/phase_arena.zig
@@ -0,0 +1,105 @@
+//! Two mutually exclusive scratch lifetimes sharing one allocation. This is an allocation-time layout only:
+//! callers, not this helper, must prove same-stream completion and overwrite-before-read at every phase boundary.
+const std = @import("std");
+
+pub const Phase = enum { attention, experts };
+pub const Pool = struct {
+    base: u64 = 0, // zero: disabled, keep the caller's original allocation sequence
+    capacity: usize = 0,
+    expected: [2]usize = .{ 0, 0 },
+    used: [2]usize = .{ 0, 0 },
+
+    fn aligned(n: usize) !usize {
+        return (try std.math.add(usize, n, 255)) & ~@as(usize, 255);
+    }
+
+    pub fn footprint(sizes: []const usize) !usize {
+        var end: usize = 0;
+        for (sizes) |bytes| {
+            if (bytes == 0) continue;
+            end = try std.math.add(usize, try aligned(end), bytes);
+        }
+        return end;
+    }
+
+    pub fn init(a: anytype, attention: []const usize, experts: []const usize) !Pool {
+        const sizes = [2]usize{ try footprint(attention), try footprint(experts) };
+        const capacity = @max(sizes[0], sizes[1]);
+        if (capacity == 0) return error.EmptyPhasePool;
+        _ = try aligned(capacity); // the backing allocator must be able to round its allocation up, too
+        const base = try a.take(capacity);
+        if (base == 0 or base % 256 != 0) return error.BadPhaseBase;
+        _ = try std.math.add(u64, base, capacity);
+        return .{ .base = base, .capacity = capacity, .expected = sizes };
+    }
+
+    pub fn take(p: *Pool, a: anytype, phase: Phase, bytes: usize) !u64 {
+        if (p.base == 0) return a.take(bytes);
+        if (bytes == 0) return p.base;
+        const i = @backingInt(phase);
+        const at = try aligned(p.used[i]);
+        const end = try std.math.add(usize, at, bytes);
+        if (end > p.expected[i] or end > p.capacity) return error.PhasePoolFull;
+        p.used[i] = end;
+        return p.base + at;
+    }
+
+    pub fn finish(p: *const Pool) !void {
+        if (p.base != 0 and !std.meta.eql(p.used, p.expected)) return error.PhasePoolIncomplete;
+    }
+};
+
+const Fake = struct {
+    next: u64 = 4096,
+    calls: usize = 0,
+    bytes: usize = 0,
+    pub fn take(a: *Fake, bytes: usize) !u64 {
+        const at = a.next;
+        a.next += (bytes + 255) & ~@as(u64, 255);
+        a.calls += 1;
+        a.bytes += bytes;
+        return at;
+    }
+};
+
+test "phase pool shares only across lifetimes and consumes one maximum-sized allocation" {
+    var a: Fake = .{};
+    var p = try Pool.init(&a, &.{ 17, 512, 3 }, &.{ 600, 10 });
+    try std.testing.expectEqual(@as(usize, 778), p.capacity);
+    const a0 = try p.take(&a, .attention, 17);
+    const a1 = try p.take(&a, .attention, 512);
+    const a2 = try p.take(&a, .attention, 3);
+    const e0 = try p.take(&a, .experts, 600);
+    const e1 = try p.take(&a, .experts, 10);
+    try std.testing.expectEqual(a0, e0);
+    try std.testing.expect(a1 >= a0 + 17 and a2 >= a1 + 512 and e1 >= e0 + 600);
+    for ([_]u64{ a0, a1, a2, e0, e1 }) |addr| try std.testing.expectEqual(@as(u64, 0), addr % 256);
+    try p.finish();
+    try std.testing.expectEqual(@as(usize, 1), a.calls);
+    try std.testing.expectEqual(@as(usize, 778), a.bytes);
+    try std.testing.expectError(error.PhasePoolFull, p.take(&a, .experts, 1));
+}
+
+test "disabled phase pool leaves allocations independent and in their original order" {
+    var a: Fake = .{};
+    var p: Pool = .{};
+    const x = try p.take(&a, .attention, 1024);
+    const y = try p.take(&a, .experts, 512);
+    try std.testing.expectEqual(x + 1024, y);
+    try std.testing.expectEqual(@as(usize, 2), a.calls);
+    try std.testing.expectEqual(@as(usize, 1536), a.bytes);
+    try p.finish();
+}
+
+test "phase pool detects overflow, incomplete plans, zero-sized entries, and exact bounds" {
+    try std.testing.expectError(error.Overflow, Pool.footprint(&.{ std.math.maxInt(usize) - 256, 512 }));
+    var a: Fake = .{};
+    try std.testing.expectError(error.EmptyPhasePool, Pool.init(&a, &.{0}, &.{}));
+    var p = try Pool.init(&a, &.{ 0, 257, 0 }, &.{256});
+    _ = try p.take(&a, .attention, 257);
+    _ = try p.take(&a, .attention, 0);
+    try std.testing.expectError(error.PhasePoolIncomplete, p.finish());
+    _ = try p.take(&a, .experts, 256);
+    try p.finish();
+    try std.testing.expectError(error.PhasePoolFull, p.take(&a, .attention, 1));
+}
