+    try std.testing.expect(s.find(&changed, &.{ 4, 8 }) == null);
+    changed = tokens;
+    changed[4] = 42; // the shorter state's lookahead, not just the longer state's history
+    try std.testing.expect(s.find(&changed, &.{ 4, 8 }) == null);
+    changed = tokens;
