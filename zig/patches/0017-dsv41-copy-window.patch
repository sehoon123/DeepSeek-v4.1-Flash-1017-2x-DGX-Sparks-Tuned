+
+/// A test proposer (a request's "oracle", a serial run's reply): the reply's next tokens as a copy, one of them made
+/// wrong in --oracle-miss percent of the windows (splitmix64 from --oracle-seed), so a lone stream's windows of every
+/// width end at every row; its match is past every enter_match, so each of its rounds is a copy window.
+const Oracle = struct {
+    reply: []const u32,
+    prompt_len: usize,
+    miss: u32,
+    state: u64,
+    out: [64]u32 = undefined,
+
+    fn next(o: *Oracle) u64 {
+        o.state +%= 0x9E3779B97F4A7C15;
+        var z = o.state;
+        z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
+        z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
+        return z ^ (z >> 31);
+    }
+
+    fn proposer(o: *Oracle) lanes.proposer.Proposer {
+        return .{ .ptr = o, .vtable = &vtable };
+    }
+
+    const vtable: lanes.proposer.Proposer.VTable = .{ .propose = proposeFn, .last_match = lastMatchFn };
+
+    fn proposeFn(ptr: *anyopaque, context: []const u32, max_draft: i64) anyerror![]const u32 {
+        const o: *Oracle = @ptrCast(@alignCast(ptr));
+        if (max_draft <= 0 or context.len <= o.prompt_len) return o.out[0..0];
+        const at = context.len - o.prompt_len;
+        if (at >= o.reply.len) return o.out[0..0];
+        const n = @min(@as(usize, @intCast(max_draft)), @min(o.reply.len - at, o.out.len));
+        @memcpy(o.out[0..n], o.reply[at..][0..n]);
+        if (o.next() % 100 < o.miss) {
+            const bad: usize = @intCast(o.next() % n);
+            o.out[bad] = (o.out[bad] + 1) % 129280;
+        }
+        return o.out[0..n];
+    }
+
+    fn lastMatchFn(ptr: *anyopaque) i64 {
+        _ = ptr;
+        return 1 << 20;
+    }
 };
 
