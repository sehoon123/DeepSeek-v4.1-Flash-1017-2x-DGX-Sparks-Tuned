diff --git a/zig/src/server/sse.zig b/zig/src/server/sse.zig
index de30ac1..05182c2 100644
--- a/zig/src/server/sse.zig
+++ b/zig/src/server/sse.zig
@@ -23,6 +23,12 @@ pub fn done(conn: *Conn) error{Closed}!void {
     return conn.writeAll("data: [DONE]\n\n");
 }
 
+/// Standard SSE comment: clients ignore it as an event, while body-idle timers see activity.
+/// No allocation and no model/request data. It must never be counted as a generated token or TTFT.
+pub fn keepalive(conn: *Conn) error{Closed}!void {
+    return conn.writeAll(": keep-alive\n\n");
+}
