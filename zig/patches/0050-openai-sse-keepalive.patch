 pub const Sink = struct {
     ctx: *anyopaque,
     call: *const fn (ctx: *anyopaque, delta: Value) error{Closed}!void,
+    /// Transport-only SSE comment; never a model token, delta, usage item, or first-token event.
+    pulse: ?*const fn (ctx: *anyopaque) error{Closed}!void = null,
 };
 
+const Keepalive = struct {
+    const interval_ns = 15 * std.time.ns_per_s;
+    last_ns: i96,
+
+    fn tick(k: *Keepalive, sink: Sink, now: i96) error{Closed}!void {
+        const pulse = sink.pulse orelse return;
+        if (now - k.last_ns < interval_ns) return;
+        try pulse(sink.ctx);
+        k.last_ns = now;
+    }
+};
+
+test "stream keepalive is periodic transport-only and propagates a closed writer" {
+    const Fake = struct {
+        pulses: usize = 0,
+        deltas: usize = 0,
+        closed: bool = false,
+        fn call(p: *anyopaque, _: Value) error{Closed}!void {
+            const s: *@This() = @ptrCast(@alignCast(p));
+            s.deltas += 1;
+        }
+        fn pulse(p: *anyopaque) error{Closed}!void {
+            const s: *@This() = @ptrCast(@alignCast(p));
+            if (s.closed) return error.Closed;
+            s.pulses += 1;
+        }
+    };
+    var f: Fake = .{};
+    const sink: Sink = .{ .ctx = &f, .call = Fake.call, .pulse = Fake.pulse };
+    var k: Keepalive = .{ .last_ns = 100 };
+    try k.tick(sink, 100 + Keepalive.interval_ns - 1);
+    try std.testing.expectEqual(@as(usize, 0), f.pulses);
+    try k.tick(sink, 100 + Keepalive.interval_ns);
+    try k.tick(sink, 100 + Keepalive.interval_ns + 1);
+    try std.testing.expectEqual(@as(usize, 1), f.pulses);
+    try k.tick(sink, 100 + 2 * Keepalive.interval_ns);
+    try std.testing.expectEqual(@as(usize, 2), f.pulses);
+    try std.testing.expectEqual(@as(usize, 0), f.deltas);
+    f.closed = true;
+    try std.testing.expectError(error.Closed, k.tick(sink, 100 + 3 * Keepalive.interval_ns));
+    try std.testing.expectEqual(@as(i96, 100 + 2 * Keepalive.interval_ns), k.last_ns);
+    // Non-streamed/translated outputs without a pulse remain unaffected.
+    try k.tick(.{ .ctx = &f, .call = Fake.call }, 100 + 4 * Keepalive.interval_ns);
+    try std.testing.expectEqual(@as(usize, 2), f.pulses);
+}
