@@ -0,0 +1,49 @@
+//! The call gate's blank check (tool_choice "required") against the real tokenizer: whitespace passes the gate.
+const std = @import("std");
+const api = @import("engine_api");
+const Server = @import("server.zig").Server;
+const HfText = @import("hf_text.zig").HfText;
+
+const Fake = struct {
+    fn engine(f: *Fake) api.Engine {
+        return .{ .ctx = f, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 1048576, .efforts = &.{.{ .name = "max", .value = 100 }} };
+    }
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {
+        return error.Closed;
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+test "bundle4b: the call gate reads the real tokenizer's whitespace tokens as blank" {
+    const dir = std.c.getenv("TF_TEST_MODEL") orelse return error.SkipZigTest;
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const work = arena.allocator();
+    var problem: []const u8 = "";
+    const text = try HfText.load(a, std.testing.io, std.mem.span(dir), work, &problem);
+    defer text.deinit();
+    var fake: Fake = .{};
+    const srv = try Server.init(a, std.testing.io, fake.engine(), text.text(), .{ .served_name = "fixture", .model_ids = &.{"fixture"}, .keep_warm_s = 0 }, null);
+    defer srv.deinit();
+    // the template writes "\n\n" between the reasoning's close and the tool-call markup: the gate must let it through
+    for ([_][]const u8{ "\n\n", "\n", " ", "\t", "                " }) |s| {
+        const ids = try srv.text.encode(work, s, false);
+        try std.testing.expect(ids.len > 0);
+        for (ids) |id| try std.testing.expect(Server.callBlank(srv, id));
+    }
+    for ([_][]const u8{ "<", "Hello", "x" }) |s| {
+        const ids = try srv.text.encode(work, s, false);
+        try std.testing.expect(!Server.callBlank(srv, ids[0]));
+    }
+    for (srv.text.eosIds()) |e| try std.testing.expect(!Server.callBlank(srv, e));
+}
