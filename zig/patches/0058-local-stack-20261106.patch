+/// The longest prefix of `s` a held memo shares.
+fn hardeningLongestMemo(t: *const HfText, s: []const u8) usize {
+    var longest: usize = 0;
+    for (t.memos) |m| {
+        if (m.text.len == 0) continue;
+        longest = @max(longest, std.mem.findDiff(u8, m.text, s) orelse s.len);
+    }
+    return longest;
+}
