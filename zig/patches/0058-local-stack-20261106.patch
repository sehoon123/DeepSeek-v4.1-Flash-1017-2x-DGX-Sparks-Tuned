+            for (&boxes, &requests, 0..) |*box, *request, i| {
+                const expected: Reason = if (i == 0 and which == .outer_cancel) .cancelled else if (i == 2 and (which == .queued_short_cancel or which == .nested_short_cancel)) .cancelled else if (i == 2 and which == .short_fault) .failed else .length;
