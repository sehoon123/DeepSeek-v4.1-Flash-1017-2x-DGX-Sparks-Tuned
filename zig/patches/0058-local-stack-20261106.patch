+    try std.testing.expectEqual(@as(usize, 0), idxRows(idx_keys, 48, 1 << 25)); // Round.init refuses such a pool
+    try std.testing.expectEqual(@as(usize, 2), idxRows(1 << 21, 48, 1 << 20)); // the A/B knob: blocks of two rows past 512K
