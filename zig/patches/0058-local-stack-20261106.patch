+/// The finish reasons /metrics counts replies by, as the chat layer ends them (the last: every other one). A reply
+/// with tool calls counts under its end here (stop or length): the API layers name tool_calls after this count.
+const finish_names = [_][]const u8{ "stop", "length", "other" };
+
+/// Whether the thinking budget closed a reply's reasoning: the cut takes the budget's last position (lanes
+/// stream.thinkCut), and the close's first token ("\n") comes before </think>, so a closed think counts at least
+/// `budget` reasoning tokens and a natural close at most budget - 2.
+pub fn budgetClosed(budget: u32, reasoning: usize) bool {
