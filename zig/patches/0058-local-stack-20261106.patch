+/// MemAvailable in bytes (0 when /proc/meminfo cannot be read: the tower then stays closed).
+fn availableBytes(io: std.Io) u64 {
+    var file = std.Io.Dir.cwd().openFile(io, "/proc/meminfo", .{}) catch return 0;
+    defer file.close(io);
+    var buf: [4096]u8 = undefined;
+    var r = file.readerStreaming(io, &buf);
+    var text: [8192]u8 = undefined;
+    const n = r.interface.readSliceShort(&text) catch return 0;
+    return memAvailable(text[0..n]) orelse 0;
+}
+
+fn memAvailable(text: []const u8) ?u64 {
+    var rows = std.mem.tokenizeScalar(u8, text, '\n');
+    while (rows.next()) |row| {
+        var words = std.mem.tokenizeAny(u8, row, ": \t");
+        if (!std.mem.eql(u8, words.next() orelse continue, "MemAvailable")) continue;
+        const kib = std.fmt.parseInt(u64, words.next() orelse return null, 10) catch return null;
+        return std.math.mul(u64, kib, 1024) catch null;
+    }
+    return null;
+}
+
+fn roomToOpen(available: u64) bool {
+    return available >= open_room + open_margin;
+}
+
+fn idleLong(last_used: i96, now: i96) bool {
+    return now - last_used >= idle_ns;
+}
