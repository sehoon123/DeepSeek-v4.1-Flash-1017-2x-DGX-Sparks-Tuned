+/// The finished reason each job (by id) heard.
+const HardeningRec = struct {
+    finished: [4]?Reason = @splat(null),
+
+    fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+        const r: *HardeningRec = @ptrCast(@alignCast(ctx));
+        switch (e.*) {
+            .finished => |f| r.finished[@intCast(id)] = f.reason,
+            else => {},
+        }
+    }
+
+    fn sink(r: *HardeningRec) Sink {
+        return .{ .ctx = r, .event = event };
+    }
+};
