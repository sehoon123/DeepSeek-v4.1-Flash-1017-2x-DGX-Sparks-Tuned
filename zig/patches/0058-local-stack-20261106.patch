diff --git a/zig/src/server/parity_test.zig b/zig/src/server/parity_test.zig
new file mode 100644
index 0000000..4d2f161
--- /dev/null
+++ b/zig/src/server/parity_test.zig
@@ -0,0 +1,167 @@
+//! Bundle 8: whole and streamed replies agree where scout A found them apart (A-F2, A-F3); bytes as tokens.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const json = server.json;
+const model_text = @import("model_text.zig");
+const openai = @import("openai.zig");
+const Conn = @import("http_conn.zig").Conn;
+
+/// Bytes as tokens; every prompt renders as "prompt".
+const ByteText = struct {
+    fn text(t: *@This()) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+    fn encode(_: *anyopaque, a: std.mem.Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const ids = try a.alloc(u32, input.len);
+        for (input, ids) |byte, *id| id.* = byte;
+        return ids;
+    }
+    fn decode(_: *anyopaque, a: std.mem.Allocator, ids: []const u32) std.mem.Allocator.Error![]u8 {
+        const out = try a.alloc(u8, ids.len);
+        for (ids, out) |id, *byte| byte.* = @intCast(id);
+        return out;
+    }
+    fn tokenId(_: *anyopaque, _: []const u8) ?u32 {
+        return null;
+    }
+    fn tokenString(_: *anyopaque, a: std.mem.Allocator, id: u32) std.mem.Allocator.Error![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+    fn vocabSize(_: *anyopaque) u32 {
+        return 256;
+    }
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+    fn render(_: *anyopaque, a: std.mem.Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error![]u8 {
+        return a.dupe(u8, "prompt");
+    }
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// An engine whose reply is `reply`'s bytes, one token each, ended with `reason`.
+const Scripted = struct {
+    reply: []const u8,
+    reason: api.Reason,
+    ids: [512]u32 = undefined,
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 4096 };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *@This() = @ptrCast(@alignCast(ctx));
+        for (e.reply, e.ids[0..e.reply.len]) |byte, *t| t.* = byte;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        sink.event(sink.ctx, id, &.{ .tokens = e.ids[0..e.reply.len] });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = e.reason } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// What a stream sent (its content and reasoning deltas joined) and a whole reply's message.
+const Seen = struct {
+    a: std.mem.Allocator,
+    content: std.ArrayList(u8) = .empty,
+    reasoning: std.ArrayList(u8) = .empty,
+    whole_content: ?[]const u8 = null,
+    whole_reasoning: ?[]const u8 = null,
+    status: ?u16 = null,
+
+    fn out(c: *Seen) openai.Out {
+        return .{ .ctx = c, .vt = &.{ .open = open, .event = event, .reply = reply } };
+    }
+    fn open(_: *anyopaque) error{Closed}!void {}
+    fn event(ctx: *anyopaque, payload: ?json.Value) error{Closed}!void {
+        const c: *Seen = @ptrCast(@alignCast(ctx));
+        const p = payload orelse return;
+        const choices = p.get("choices") orelse return;
+        if (choices != .array) return;
+        for (choices.array) |choice| {
+            const d = choice.get("delta") orelse continue;
+            if (d.get("content")) |v| if (v == .string) c.content.appendSlice(c.a, v.string) catch return error.Closed;
+            if (d.get("reasoning_content")) |v| if (v == .string) c.reasoning.appendSlice(c.a, v.string) catch return error.Closed;
+        }
+    }
+    fn reply(ctx: *anyopaque, status: u16, payload: json.Value) void {
+        const c: *Seen = @ptrCast(@alignCast(ctx));
+        c.status = status;
+        const choices = payload.get("choices") orelse return;
+        if (choices != .array or choices.array.len == 0) return;
+        const m = choices.array[0].get("message") orelse return;
+        if (m.get("content")) |v| if (v == .string) {
+            c.whole_content = v.string;
+        };
+        if (m.get("reasoning_content")) |v| if (v == .string) {
+            c.whole_reasoning = v.string;
+        };
+    }
+};
+
+fn run(a: std.mem.Allocator, script: *Scripted, body: []const u8) !Seen {
+    var text: ByteText = .{};
+    var srv = try server.Server.init(std.testing.allocator, std.testing.io, script.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    const raw = (try json.parse(a, body)).ok;
+    var conn: Conn = .{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+    var seen: Seen = .{ .a = a };
+    openai.run(srv, a, seen.out(), .{ .conn = &conn }, true, raw);
+    return seen;
+}
+
+test "bundle8: a streamed think cut by max_tokens sends its last characters too (A-F2)" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    // the reasoning starts with a newline the whole reply strips, and ends with "<", which a stream holds as a
+    // possible </think>
+    var script: Scripted = .{ .reply = "\nplan<", .reason = .length };
+    const body =
+        \\{"model":"test-model","messages":[{"role":"user","content":"x"}],"stream":true,"max_tokens":6,
+        \\ "chat_template_kwargs":{"enable_thinking":true}}
+    ;
+    const seen = try run(a, &script, body);
+    try std.testing.expectEqualStrings("\nplan<", seen.reasoning.items);
+}
+
+test "bundle8: a reply that ends inside a DSML call block shows no markup, whole or streamed (A-F3)" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reply = "Hi <\u{ff5c}DSML\u{ff5c} calls>\n<\u{ff5c}DSML\u{ff5c} invoke name=\"f\">";
+    const tools =
+        \\"tools":[{"type":"function","function":{"name":"f","parameters":{"type":"object","properties":{}}}}]
+    ;
+    for ([_]bool{ false, true }) |stream| {
+        var script: Scripted = .{ .reply = reply, .reason = .stop };
+        const body = try std.fmt.allocPrint(a, "{{\"model\":\"test-model\",\"messages\":[{{\"role\":\"user\",\"content\":\"x\"}}],\"stream\":{},\"max_tokens\":64,{s}}}", .{ stream, tools });
+        const seen = try run(a, &script, body);
+        const shown = if (stream) seen.content.items else seen.whole_content orelse "";
+        try std.testing.expect(std.mem.indexOf(u8, shown, "DSML") == null);
+        try std.testing.expectEqualStrings("Hi", std.mem.trim(u8, shown, " \n"));
+    }
+}
+
+test "bundle8: a closed DSML block, or none, is not an unclosed one" {
+    const tool_parse = @import("tool_parse.zig");
+    try std.testing.expect(tool_parse.unclosedDsml("Hi <\u{ff5c}DSML\u{ff5c} calls>\n<\u{ff5c}DSML\u{ff5c} invoke name=\"f\">"));
+    try std.testing.expect(!tool_parse.unclosedDsml("Hi <\u{ff5c}DSML\u{ff5c} calls>x</\u{ff5c}DSML\u{ff5c} calls>"));
+    try std.testing.expect(!tool_parse.unclosedDsml("Hi, no calls here"));
+    try std.testing.expect(tool_parse.unclosedDsml("<\u{ff5c}DSML\u{ff5c}tool_calls>open"));
+}
diff --git a/zig/src/server/prefix_cache_test.zig b/zig/src/server/prefix_cache_test.zig
new file mode 100644
index 0000000..b598e3b
--- /dev/null
+++ b/zig/src/server/prefix_cache_test.zig
@@ -0,0 +1,130 @@
+//! Real tokenizer -> Server.init -> prompt.prepare -> exact cache begin/keep/restore.
+//! Only snapshot storage is fake. No HTTP, engine submission, weights, GPU or live cache.
+const std = @import("std");
+const api = @import("engine_api");
+const pc = api.prompt_cache;
+const json = @import("json.zig");
+const Server = @import("server.zig").Server;
+const HfText = @import("hf_text.zig").HfText;
+const prompt = @import("prompt.zig");
+const Cx = @import("errors.zig").Cx;
+
+const Fake = struct {
+    submitted: usize = 0,
+    saves: usize = 0,
+    restores: usize = 0,
+    restored_at: u32 = 0,
+
+    fn engine(f: *Fake) api.Engine {
+        return .{ .ctx = f, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 1048576, .efforts = &.{.{ .name = "max", .value = 100 }} };
+    }
+    fn submit(ptr: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        f.submitted += 1;
+        return error.Closed;
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+    fn snapshots(f: *Fake) pc.Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop } };
+    }
+    fn bytes(_: *anyopaque, _: u32) u64 {
+        return @sizeOf(u32);
+    }
+    fn save(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        const saved = try std.testing.allocator.create(u32);
+        saved.* = at;
+        f.saves += 1;
+        return saved;
+    }
+    fn restore(ptr: *anyopaque, _: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        const f: *Fake = @ptrCast(@alignCast(ptr));
+        f.restored_at = @as(*u32, @ptrCast(@alignCast(saved))).*;
+        f.restores += 1;
+    }
+    fn drop(_: *anyopaque, saved: pc.Saved) void {
+        std.testing.allocator.destroy(@as(*u32, @ptrCast(@alignCast(saved))));
+    }
+};
+
+test "real server preparation resumes exact history after private-use tool results" {
+    const dir = std.c.getenv("TF_TEST_MODEL") orelse return error.SkipZigTest;
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const work = arena.allocator();
+    var problem: []const u8 = "";
+    const text = try HfText.load(a, std.testing.io, std.mem.span(dir), work, &problem);
+    defer text.deinit();
+    var fake: Fake = .{};
+    const srv = try Server.init(a, std.testing.io, fake.engine(), text.text(), .{ .served_name = "fixture", .model_ids = &.{"fixture"}, .keep_warm_s = 0 }, null);
+    defer srv.deinit();
+    try std.testing.expectEqual(@as(?i64, 100), srv.effortValue("max"));
+    var cx: Cx = .{ .a = work };
+    // Cross the real cache's default min_prompt=4096, rather than weakening its policy for the fixture.
+    var user: std.ArrayList(u8) = .empty;
+    try user.appendSlice(work, "literal </think> here ");
+    for (0..8192) |_| try user.appendSlice(work, "value ");
+    var result: std.ArrayList(u8) = .empty;
+    for (0..256) |_| try result.appendSlice(work, "row ");
+    const call =
+        \\{"role":"assistant","content":"","reasoning_content":"lookup","tool_calls":[{"id":"call1","type":"function","function":{"name":"lookup","arguments":"{\"q\":\"x\"}"}}]}
+    ;
+    const history_doc = try std.mem.concat(work, u8, &.{ "[{\"role\":\"system\",\"content\":\"Be precise.\"},{\"role\":\"user\",\"content\":\"", user.items, "\"},", call, "]" });
+    const history = (try json.parseText(work, history_doc)).ok;
+    const tools = (try json.parseText(work, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"description\":\"Find a value\",\"parameters\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"string\"}}}}}]")).ok;
+    const changed_tools = (try json.parseText(work, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"description\":\"Different tool semantics\",\"parameters\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"string\"}}}}}]")).ok;
+    const changed_doc = try std.mem.concat(work, u8, &.{ "[{\"role\":\"system\",\"content\":\"Different instructions.\"},{\"role\":\"user\",\"content\":\"", user.items, "\"},", call, "]" });
+    var cases: usize = 0;
+    for ([_]bool{ false, true }) |thinking| {
+        const first = try prompt.prepare(srv, &cx, .{ .messages = .{ .array = history.array[0..2] }, .tools = tools.array, .fields = .null }, thinking, "max");
+        const before = try prompt.prepare(srv, &cx, .{ .messages = history, .tools = tools.array, .fields = .null }, thinking, "max");
+        try std.testing.expect(first.ids.len >= 4096);
+        try std.testing.expect(before.history_len > first.ids.len);
+        for ([_][]const u8{ "ordinary", "\u{E000}0\u{E001}", "</think>\u{E000}0\u{E001}", "\u{E001}" }, 0..) |suffix, k| {
+            const tool_result = try std.mem.concat(work, u8, &.{ ",{\"role\":\"tool\",\"tool_call_id\":\"call1\",\"content\":\"", result.items, suffix, "\"}]" });
+            const next_doc = try std.mem.concat(work, u8, &.{ history_doc[0 .. history_doc.len - 1], tool_result });
+            const next_messages = (try json.parseText(work, next_doc)).ok;
+            const after = try prompt.prepare(srv, &cx, .{ .messages = next_messages, .tools = tools.array, .fields = .null }, thinking, "max");
+            // DSV41's supported sliding_window is128 (Config.supported); keep the same resume-tail constraint.
+            var cache = pc.Store.init(a, fake.snapshots(), .{ .tail = 128 }, 4096);
+            defer cache.deinit();
+            const planned = try cache.begin(work, before.ids, @intCast(before.history_len), &.{}, &.{}, null);
+            try std.testing.expectEqual(@as(u32, 0), planned.from);
+            try std.testing.expectEqualSlices(u32, &.{@intCast(before.history_len)}, planned.marks);
+            try std.testing.expect(cache.keep(before.ids, planned.marks[0], null, &.{}));
+            const resumed = try cache.begin(work, after.ids, @intCast(after.history_len), &.{}, &.{}, null);
+            if (resumed.from != before.history_len) {
+                std.debug.print("server-path prefix cache miss: thinking={}, suffix={d}, expected={d}, resumed={d}\n", .{ thinking, k, before.history_len, resumed.from });
+                return error.PrefixCacheMiss;
+            }
+            try std.testing.expectEqualSlices(u32, before.ids[0..resumed.from], after.ids[0..resumed.from]);
+            try std.testing.expectEqual(resumed.from, fake.restored_at);
+            try std.testing.expectEqual(@as(u64, 1), cache.counts.hits);
+            try std.testing.expect(after.history_len > resumed.from);
+            const changed_next = try std.mem.concat(work, u8, &.{ changed_doc[0 .. changed_doc.len - 1], tool_result });
+            const changed = try prompt.prepare(srv, &cx, .{ .messages = (try json.parseText(work, changed_next)).ok, .tools = tools.array, .fields = .null }, thinking, "max");
+            const changed_tool = try prompt.prepare(srv, &cx, .{ .messages = next_messages, .tools = changed_tools.array, .fields = .null }, thinking, "max");
+            // A miss must be caused by incompatible tokens, not the minimum resume tail.
+            try std.testing.expect(changed.ids.len >= before.history_len + cache.rules.tail);
+            try std.testing.expect(changed_tool.ids.len >= before.history_len + cache.rules.tail);
+            try std.testing.expect(cache.find(after.ids, &.{}) != null);
+            if (cache.find(changed.ids, &.{}) != null) return error.ChangedInstructionsReused;
+            if (cache.find(changed_tool.ids, &.{}) != null) return error.ChangedToolsReused;
+            cases += 1;
+        }
+    }
+    try std.testing.expectEqual(cases, fake.saves);
+    try std.testing.expectEqual(cases, fake.restores);
+    try std.testing.expectEqual(@as(usize, 0), fake.submitted);
+    std.debug.print("PASS {d} real server-prepare/cache scenarios, default min_prompt4096/tail128; exact history+reply restored, changed instructions/tools miss; zero engine submissions\n", .{cases});
+}
