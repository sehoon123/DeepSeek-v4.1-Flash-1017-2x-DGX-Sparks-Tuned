diff --git a/zig/src/core/prompt_cache_hardening_test.zig b/zig/src/core/prompt_cache_hardening_test.zig
new file mode 100644
index 0000000..8299b35
--- /dev/null
+++ b/zig/src/core/prompt_cache_hardening_test.zig
@@ -0,0 +1,163 @@
+//! Step-1 hardening: a shared cut's key on its family's grain, invalid states freed first, the store's status.
+//! The "hardening red" tests also build against the deployed store, where they fail by assertion.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const A = std.testing.allocator;
+
+/// A family over host memory: a position and a running sum; `valid` cleared as when placement overwrites the rows.
+const Fake = struct {
+    at: u32 = 0,
+    sum: u64 = 0,
+    live: usize = 0,
+
+    const State = struct { at: u32, sum: u64, valid: bool = true };
+
+    fn state(saved: pc.Saved) *State {
+        return @ptrCast(@alignCast(saved));
+    }
+    fn of(ptr: *anyopaque) *Fake {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn snapshots(f: *Fake) pc.Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop, .valid = valid } };
+    }
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 100 + @as(u64, at);
+    }
+    fn valid(_: *anyopaque, saved: pc.Saved) bool {
+        return state(saved).valid;
+    }
+    fn save(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f = of(ptr);
+        if (at != f.at) return error.NotAtMark;
+        const st = try A.create(State);
+        st.* = .{ .at = at, .sum = f.sum };
+        f.live += 1;
+        return st;
+    }
+    fn restore(ptr: *anyopaque, _: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        const st = state(saved);
+        if (!st.valid) return error.StaleRows;
+        const f = of(ptr);
+        f.at = st.at;
+        f.sum = st.sum;
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        A.destroy(state(saved));
+        of(ptr).live -= 1;
+    }
+
+    /// A prompt pass from `plan.from` keeping each mark's state at the last `grain` end at or before it, as DeepSeek's does.
+    fn pass(f: *Fake, s: *pc.Store, prompt: []const u32, plan: pc.Plan, grain: u32) void {
+        if (plan.from == 0) {
+            f.at = 0;
+            f.sum = 0;
+        }
+        for (prompt[plan.from..]) |t| {
+            f.sum = f.sum *% 31 +% t;
+            f.at += 1;
+            for (plan.marks) |w| if (w / grain * grain == f.at) {
+                _ = s.keep(prompt, f.at, null, &.{});
+                break;
+            };
+        }
+    }
+};
+
+test "hardening red: a shared cut is marked shared where its family keeps it, below the cut" {
+    var f: Fake = .{};
+    var rules: pc.Rules = .{ .min_prompt = 0, .min_gap = 1 };
+    if (@hasField(pc.Rules, "grain")) rules.grain = 4;
+    var s = pc.Store.init(A, f.snapshots(), rules, 10_000);
+    defer s.deinit();
+    var arena: std.heap.ArenaAllocator = .init(A);
+    defer arena.deinit();
+    var prompt: [30]u32 = undefined;
+    for (&prompt, 1..) |*t, i| t.* = @intCast(i);
+    // a 10-token system block (its cut off the grain) and the history at 29: kept at 8 and 28
+    const plan = try s.begin(arena.allocator(), &prompt, 29, &.{10}, &.{}, null);
+    f.pass(&s, &prompt, plan, 4);
+    var cut: ?*pc.Entry = null;
+    for (s.entries.items) |e| if (e.at == 8) {
+        cut = e;
+    };
+    try std.testing.expect(cut != null);
+    try std.testing.expect(cut.?.shared);
+}
+
+test "hardening red: a state whose rows were overwritten is freed before live ones" {
+    var f: Fake = .{};
+    var s = pc.Store.init(A, f.snapshots(), .{ .min_prompt = 0 }, 300); // room for two states of 104 bytes
+    defer s.deinit();
+    const p1 = [_]u32{ 1, 1, 1, 1, 1, 1, 1, 1 };
+    const p2 = [_]u32{ 2, 2, 2, 2, 2, 2, 2, 2 };
+    const p3 = [_]u32{ 3, 3, 3, 3, 3, 3, 3, 3 };
+    f.pass(&s, &p1, .{ .marks = &.{4} }, 1);
+    f.pass(&s, &p2, .{ .marks = &.{4} }, 1);
+    try std.testing.expectEqual(@as(usize, 2), s.entries.items.len);
+    Fake.state(s.entries.items[1].saved).valid = false; // the newer one's rows overwritten
+    f.pass(&s, &p3, .{ .marks = &.{4} }, 1); // its room: the dead state goes, not the older live one
+    try std.testing.expectEqual(@as(usize, 2), s.entries.items.len);
+    try std.testing.expect(s.find(&p1, &.{}) != null);
+    try std.testing.expect(s.find(&p3, &.{}) != null);
+    try std.testing.expectEqual(@as(usize, 2), f.live);
+}
+
+test "hardening: status counts kept states, their charge, host token copies and invalid ones" {
+    var f: Fake = .{};
+    var s = pc.Store.init(A, f.snapshots(), .{ .min_prompt = 0 }, 1000);
+    defer s.deinit();
+    const p1 = [_]u32{ 1, 1, 1, 1, 1, 1, 1, 1 };
+    const p2 = [_]u32{ 2, 2, 2, 2, 2, 2, 2, 2, 2, 2 };
+    f.pass(&s, &p1, .{ .marks = &.{4} }, 1);
+    f.pass(&s, &p2, .{ .marks = &.{6} }, 1);
+    Fake.state(s.entries.items[0].saved).valid = false;
+    const st = s.status();
+    try std.testing.expectEqual(@as(u32, 2), st.entries);
+    try std.testing.expectEqual(@as(u32, 1), st.invalid);
+    try std.testing.expectEqual(@as(u64, 104 + 106), st.held);
+    try std.testing.expectEqual(@as(u64, (8 + 10) * @sizeOf(u32)), st.host); // bundle 3: one copy a state (its prompt)
+    try std.testing.expectEqual(@as(u64, 2), st.counts.kept);
+    try std.testing.expectEqual(s.counts.misses, st.counts.misses);
+}
+
+test "bundle3: a kept state's tokens are the head of its prompt's one host copy" {
+    var f: Fake = .{};
+    var s = pc.Store.init(A, f.snapshots(), .{ .min_prompt = 0 }, 1000);
+    defer s.deinit();
+    const p1 = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    const p2 = [_]u32{ 9, 9, 9, 9, 9, 9, 9, 9, 9, 9 };
+    f.pass(&s, &p1, .{ .marks = &.{4} }, 1);
+    f.pass(&s, &p2, .{ .marks = &.{6} }, 1);
+    for (s.entries.items) |e| {
+        try std.testing.expect(!e.split and e.tokens.ptr == e.last.ptr);
+        try std.testing.expectEqualSlices(u32, e.last[0..e.tokens.len], e.tokens);
+    }
+    try std.testing.expectEqual(@as(u64, (p1.len + p2.len) * @sizeOf(u32)), s.status().host);
+}
+
+test "bundle3: a resumed state moves its tokens into the new prompt's copy; a prompt it does not begin keeps the old" {
+    var f: Fake = .{};
+    var s = pc.Store.init(A, f.snapshots(), .{ .min_prompt = 0 }, 1000);
+    defer s.deinit();
+    const p1 = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    const p1x = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 12, 13 };
+    f.pass(&s, &p1, .{ .marks = &.{4} }, 1);
+    const e = s.find(&p1x, &.{}) orelse return error.TestUnexpectedResult;
+    s.resumed(e, &p1x, true);
+    try std.testing.expectEqualSlices(u32, &p1x, e.last);
+    try std.testing.expectEqualSlices(u32, p1[0..4], e.tokens);
+    try std.testing.expect(!e.split and e.tokens.ptr == e.last.ptr);
+    try std.testing.expectEqual(@as(u64, p1x.len * @sizeOf(u32)), s.status().host);
+    // a later turn that resumes it again (longer still): one copy again, the old one freed (the allocator checks leaks)
+    const p1y = p1x ++ [_]u32{ 14, 15 };
+    s.resumed(e, &p1y, true);
+    try std.testing.expectEqualSlices(u32, &p1y, e.last);
+    try std.testing.expect(e.tokens.ptr == e.last.ptr);
+    // a prompt the tokens do not begin: the copy stays the old prompt's (the state still holds its own tokens)
+    const other = [_]u32{ 7, 7, 7, 7, 7, 7 };
+    s.resumed(e, &other, true);
+    try std.testing.expectEqualSlices(u32, &p1y, e.last);
+    try std.testing.expectEqualSlices(u32, p1[0..4], e.tokens);
+    try std.testing.expectEqual(@as(u64, 3), s.counts.hits);
+}
