+test "bundle2: decode indexer scratch: as before while every row fits, bounded past it whatever the pool" {
+    const cb = 8;
+    const pk = 2048;
+    const R = 48;
+    // a 512K bucket: all 48 rows fit, so the keys, scores, block maxima and tile maxima are the old [R, nb] sizes
+    const nb: usize = 1 << 19;
+    const small = idxScratch(idx_keys, R, nb, cb, pk);
+    try std.testing.expectEqual(R * nb * 8, small.keys);
+    try std.testing.expectEqual(R * nb * 4, small.score);
+    try std.testing.expectEqual(R * (nb / cb + 1) * 4, small.bmax);
+    try std.testing.expectEqual(R * (nb / tri_index.tile + 1) * 8, small.tmax);
+    try std.testing.expectEqual(R * (pk + 1), small.cand); // the mask is only built while every block is in the pool
+    // 1M and 4M pools: the same scratch (404 MiB here against 612 MiB and 2448 MiB before)
+    const one = idxScratch(idx_keys, R, 1 << 20, cb, pk);
+    const four = idxScratch(idx_keys, R, 1 << 22, cb, pk);
+    // the knob's scratch is smaller still, and a block of two rows fits it
+    const knob = idxScratch(1 << 21, R, 1 << 20, cb, pk);
+    try std.testing.expect(knob.score == (1 << 21) * 4 and 2 * (1 << 20) * 8 <= knob.keys);
+    try std.testing.expectEqual(one, four);
+    const total = one.keys + one.score + one.cand + one.bmax + one.tmax;
+    try std.testing.expect(total < 405 * (1 << 20) and total > 403 * (1 << 20));
+    const before = R * (1 << 20) * 12 + R * ((1 << 20) / cb + 1) * 5 + R * ((1 << 20) / tri_index.tile + 1) * 8;
+    try std.testing.expect(before - total > 207 * (1 << 20));
+    // every block of any bucket up to the pool's fits: keys and scores at most idx_keys, maxima with a row's slack
+    for ([_]usize{ 1 << 20, 1 << 21, 1 << 22, 3 << 20 }) |n| {
+        const rb = idxRows(idx_keys, R, n);
+        try std.testing.expect(rb * n * 8 <= four.keys and rb * n * 4 <= four.score);
+        try std.testing.expect(rb * ((n + cb - 1) / cb) * 4 <= four.bmax and rb * ((n + tri_index.tile - 1) / tri_index.tile) * 8 <= four.tmax);
+    }
+    // past the candidate source every row's pool keys [R, pk * cb] still fit
+    try std.testing.expect(R * pk * cb * 8 <= one.keys);
+}
