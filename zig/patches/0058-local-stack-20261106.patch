+/// Whether the text's first DSML call block (beforeDsml's cut) has no closing tag: a reply that ended inside it.
+pub fn unclosedDsml(text: []const u8) bool {
+    const at = beforeDsml(text).len;
+    if (at == text.len) return false;
+    const rest = text[at..];
+    if (std.mem.startsWith(u8, rest, dsml41_open)) return find(rest, dsml41_close, dsml41_open.len) == null;
+    return find(rest, dsml_close, dsml_open.len) == null;
