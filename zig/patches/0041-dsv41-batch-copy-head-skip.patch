+                win.copyAhead(e, &next_who);
+            if (e.cfg.family_mtp and p.stream.drafts and !copy_next) try heads.append(a, i);
         }
         const whos = try a.alloc(depth.Who, heads.items.len);
         for (whos, heads.items) |*w, i| w.* = win.who(plans[i].stream);
