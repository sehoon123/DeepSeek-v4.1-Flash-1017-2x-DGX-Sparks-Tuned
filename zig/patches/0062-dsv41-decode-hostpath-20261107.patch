+test "bundle12: verify's records land before the absorb, which the host does not wait for" {
+    // verify's tail (land) on CPU fakes of the driver calls it makes, logged in order; no CUDA library is opened
+    const Fake = struct {
+        const Call = enum { launch, dtoh, record, wait_event, wait_stream };
+        var log: [8]Call = undefined;
+        var n: usize = 0;
+        var bytes: usize = 0;
+        var device: []const u32 = &.{}; // what the records' copy brings back
+        var recorded: cuda.abi.Event = null;
+        var waited: cuda.abi.Event = null;
+        var refuse: cuda.abi.Function = null; // the absorb's first launch, refused (NOT_READY) so it stops there
+        fn put(c: Call) void {
+            log[n] = c;
+            n += 1;
+        }
+        fn launch(f: cuda.abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+            put(.launch);
+            return if (refuse != null and f == refuse) cuda.abi.error_not_ready else cuda.abi.success;
+        }
+        fn dtoh(dst: ?*anyopaque, _: cuda.abi.DevicePtr, len: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+            put(.dtoh);
+            bytes = len;
+            const out: [*]u8 = @ptrCast(dst.?);
+            @memcpy(out[0..len], std.mem.sliceAsBytes(device)[0..len]);
+            return cuda.abi.success;
+        }
+        fn record(ev: cuda.abi.Event, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+            put(.record);
+            recorded = ev;
+            return cuda.abi.success;
+        }
+        fn waitEvent(ev: cuda.abi.Event) callconv(.c) cuda.abi.Result {
+            put(.wait_event);
+            waited = ev;
+            return cuda.abi.success;
+        }
+        fn waitStream(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+            put(.wait_stream);
+            return cuda.abi.success;
+        }
