+
+test "bundle12: two halves' records merge into the whole row's first candidates: ties across halves, -0/+0, infinities, NaN" {
+    const sampling = @import("sampling.zig");
+    const Half = struct {
+        // the device's record of a half (Ops.candidates, checked against topCandidates in 0035): its first `count`
+        // with the half's own ids, and its NaN flag
+        fn record(half: []const f32, count: usize, out: *[cand_rec]u32) void {
+            var v: [cand_max]f32 = undefined;
+            var ids: [cand_max]i64 = undefined;
+            const n = sampling.topCandidates(half, count, &v, &ids);
+            for (0..n) |j| {
+                out[j] = @bitCast(v[j]);
+                out[cand_max + j] = @intCast(ids[j]);
+            }
+            var nan = false;
+            for (half) |x| nan = nan or std.math.isNan(x);
+            out[2 * cand_max] = @intFromBool(nan);
+        }
+    };
+    var prng = std.Random.DefaultPrng.init(20261107);
+    const rnd = prng.random();
+    var row: [2 * 777]f32 = undefined;
+    var lo: [cand_rec]u32 = undefined;
+    var hi: [cand_rec]u32 = undefined;
+    var got: [cand_rec]u32 = undefined;
+    var v: [cand_max]f32 = undefined;
+    var ids: [cand_max]i64 = undefined;
+    for (0..600) |q| {
+        const H: usize = if (q % 4 == 0) cand_max + rnd.uintLessThan(usize, 40) else 777;
+        const p = [2]f32{ rnd.float(f32), rnd.float(f32) }; // each half's share of the tied values
+        for (row[0 .. 2 * H], 0..) |*x, i| {
+            const tied = rnd.float(f32) < p[i / H];
+            x.* = switch (q % 5) {
+                0 => if (tied) (if (rnd.boolean()) -0.0 else 0.0) else -1.0 - rnd.float(f32),
+                1 => @round(rnd.floatNorm(f32) * 2.0) / 2.0,
+                2 => if (tied) std.math.inf(f32) else rnd.floatNorm(f32),
+                3 => if (tied) -std.math.inf(f32) else -1.0e30,
+                else => rnd.floatNorm(f32),
+            };
+        }
+        if (q % 6 == 5) @memcpy(row[H .. 2 * H], row[0..H]); // every value tied across the halves
+        if (q % 7 == 3) row[rnd.uintLessThan(usize, 2 * H)] = std.math.nan(f32);
+        var nan = false;
+        for (row[0 .. 2 * H]) |x| nan = nan or std.math.isNan(x);
+        for ([_]usize{ 1, 2, 8, 28, 57, 64 }) |count| {
+            Half.record(row[0..H], count, &lo);
+            Half.record(row[H .. 2 * H], count, &hi);
+            mergeHalves(&lo, &hi, @intCast(H), count, &got);
+            try std.testing.expectEqual(@as(u32, @intFromBool(nan)), got[2 * cand_max]);
+            if (nan) continue;
+            try std.testing.expectEqual(count, sampling.topCandidates(row[0 .. 2 * H], count, &v, &ids));
+            for (0..count) |j| {
+                try std.testing.expectEqual(@as(u32, @intCast(ids[j])), got[cand_max + j]);
+                try std.testing.expectEqual(@as(u32, @bitCast(v[j])), got[j]);
+            }
+        }
+    }
+}
