+/// A row's record of the whole vocabulary from its two halves' records (bundle 12: each rank's Ops.candidates over its own
+/// columns; the second half's ids start at `first`): the first `count` of their union in the records' order (the larger
+/// value, -0.0 as +0.0, then the lower id, so the first half wins a tie) and the NaN flag of either half (a flagged row is
+/// never drawn from, so its values are left). The union holds the row's first `count`: one of them has fewer than `count`
+/// elements before it in its own half.
+/// The candidates kernel's value order (dsv41_ops.cu tf_cand_key): -0 as +0, then an integer that orders as the values
+/// do, whatever the CPU's float mode (review a19b2e98: a float compare under flush-to-zero ties a denormal with 0, which
+/// the kernel does not).
+fn orderKey(bits: u32) u32 {
+    const b = if (bits & 0x7fff_ffff == 0) 0 else bits;
+    return if (b & 0x8000_0000 != 0) ~b else b | 0x8000_0000;
+}
+
+pub fn mergeHalves(lo: []const u32, hi: []const u32, first: u32, count: usize, out: []u32) void {
+    const W = cand_max;
+    out[2 * W] = lo[2 * W] | hi[2 * W];
+    if (out[2 * W] != 0) return;
+    var i: usize = 0;
+    var j: usize = 0;
+    for (0..count) |k| {
+        const a = orderKey(lo[i]);
+        const b = orderKey(hi[j]);
+        if (b > a) {
+            out[k] = hi[j];
+            out[W + k] = hi[W + j] + first;
+            j += 1;
+        } else {
+            out[k] = lo[i];
+            out[W + k] = lo[W + i];
+            i += 1;
+        }
+    }
+}
