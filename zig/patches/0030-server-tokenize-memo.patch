+        ids: []u32 = &.{},
+        segs: []MemoSegment = &.{},
+
+        pub fn deinit(m: *Memo, a: Allocator) void {
+            a.free(m.text);
+            a.free(m.ids);
+            a.free(m.segs);
+            m.* = .{};
+        }
+    };
+    pub const MemoSegment = struct { start: usize, end: usize, id: ?u32, n: usize };
+
+    /// encode's ids, with `prev`'s taken for the leading top-level segments both texts have alike (the same bounds and
+    /// id, inside their common prefix): a segment's ids depend only on its bytes and on whether it starts the text, so
+    /// the ids are encode's. With `next`, this text's memo goes there, allocated with `keep`.
+    pub fn encodeReusing(t: *const Tokenizer, a: Allocator, keep: Allocator, text: []const u8, prev: ?*const Memo, next: ?*Memo) Error![]u32 {
+        if (!std.unicode.utf8ValidateSlice(text)) return t.encode(a, text); // (the lossy text's offsets are another text's)
+        var arena = std.heap.ArenaAllocator.init(a);
+        defer arena.deinit();
+        var ctx = steps.Context{ .a = arena.allocator(), .matcher = .{ .a = arena.allocator() } };
+        const segs = try t.splitAdded(&ctx, &t.raw, text);
+        var same: usize = 0;
+        var same_ids: usize = 0;
+        if (prev) |p| {
+            const common = std.mem.findDiff(u8, p.text, text) orelse text.len;
+            while (same < segs.len and same < p.segs.len) : (same += 1) {
+                const s = segs[same];
+                const q = p.segs[same];
+                if (s.start != q.start or s.end != q.end or s.end > common) break;
+                if ((s.id == null) != (q.id == null)) break;
+                if (s.id != null and s.id.? != q.id.?) break;
+                same_ids += q.n;
+            }
+        }
+        var ids: std.ArrayList(u32) = .empty;
+        if (prev) |p| try ids.appendSlice(ctx.a, p.ids[0..same_ids]);
+        const counts = try ctx.a.alloc(usize, segs.len);
+        if (prev) |p| for (counts[0..same], p.segs[0..same]) |*c, q| {
+            c.* = q.n;
+        };
+        for (segs[same..], counts[same..]) |seg, *c| {
+            const before = ids.items.len;
+            if (seg.id) |id| try ids.append(ctx.a, id) else if (seg.end > seg.start) try t.encodeText(&ctx, text[seg.start..seg.end], seg.start == 0, &ids);
+            c.* = ids.items.len - before;
+        }
+        const out = try a.dupe(u32, ids.items);
+        errdefer a.free(out);
+        if (next) |nm| {
+            const kt = try keep.dupe(u8, text);
+            errdefer keep.free(kt);
+            const ki = try keep.dupe(u32, ids.items);
+            errdefer keep.free(ki);
+            const ks = try keep.alloc(MemoSegment, segs.len);
+            for (ks, segs, counts) |*k, sg, c| k.* = .{ .start = sg.start, .end = sg.end, .id = sg.id, .n = c };
+            nm.* = .{ .text = kt, .ids = ki, .segs = ks };
+        }
