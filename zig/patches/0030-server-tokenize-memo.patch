+fn memoCheck(t: *const Tokenizer, seed: u64) !void {
+    const a = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(seed);
+    const r = prng.random();
+    const parts = [_][]const u8{ "a", "b", " ", "ab", " ab", "c", "<|end|>", "  ", "<|end|><|end|>" };
+    var memo: Tokenizer.Memo = .{};
+    defer memo.deinit(a);
+    var text: std.ArrayList(u8) = .empty;
+    defer text.deinit(a);
+    for (0..300) |step| {
+        // the next text: the last one cut somewhere (or not) and extended, as a conversation's next request
+        if (step % 17 == 0) text.clearRetainingCapacity() else if (text.items.len > 0 and r.boolean()) text.shrinkRetainingCapacity(r.uintLessThan(usize, text.items.len + 1));
+        for (0..r.uintLessThan(usize, 12) + 1) |_| try text.appendSlice(a, parts[r.uintLessThan(usize, parts.len)]);
+        const want = try t.encode(a, text.items);
+        defer a.free(want);
+        var next: Tokenizer.Memo = .{};
+        const got = try t.encodeReusing(a, a, text.items, if (memo.text.len > 0) &memo else null, &next);
+        defer a.free(got);
+        try std.testing.expectEqualSlices(u32, want, got);
+        try std.testing.expectEqualSlices(u32, want, next.ids);
+        memo.deinit(a);
+        memo = next;
+    }
+}
