+// TF_DS_HC_FUSED (this recipe): a gather's collect fused with the hc post that reads it (kernels.py _hc_post_only, op
+// for op): wait for every peer's flag at this sequence, then xo[r, s, :] = bf16(fma(post[r, s], bf16(g_0 + g_1 + ...),
+// fma(c3, x3, fma(c2, x2, fma(c0, x0, c1 * x1))))), c_j = comb[r, j, s], x_j = x[r, j, :], g_p rank p's fp32 partial (this
+// rank's own source, a peer's ring slot): the same roundings in the same order, so the same bits, and the gathered
+// partials are never written out.
+extern "C" __global__ void __launch_bounds__(COLLECT_THREADS) dsv41_rdma_collect_post(const float* __restrict__ own,
+        const char* recv_ring, const uint64_t* flags, const uint64_t* seq, int rank, int world, int slots,
+        uint64_t max_bytes, const uint64_t* abort_word, const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ xo, const float* __restrict__ post, const float* __restrict__ comb, int rows, int D,
+        int pdl) {
+    pdl_enter(pdl);                              // the staging kernel's sequence and the post's coefficients are written
+    const uint64_t q = *seq;
+    const int slot = (int)(q % slots);
+    if (threadIdx.x < world && threadIdx.x != rank)
+        for (uint32_t i = 1; load_sys(flags + (size_t)slot * world + threadIdx.x) < q; ++i)
+            if ((i & 1023) == 0 && load_sys(abort_word)) break;
+    __syncthreads();
+    const size_t wide = (size_t)4 * D;
+    const size_t n = (size_t)rows * wide;
+    for (size_t e = (size_t)blockIdx.x * blockDim.x + threadIdx.x; e < n; e += (size_t)gridDim.x * blockDim.x) {
+        const size_t r = e / wide;
+        const int rem = (int)(e - r * wide);
+        const int s = rem / D;
+        const int d = rem - s * D;
+        const size_t gi = r * D + d;
+        float ya = 0.f;
+        for (int p = 0; p < world; ++p) {
+            const float g = p == rank ? own[gi]
+                                      : __ldcv(reinterpret_cast<const float*>(recv_ring + ((size_t)slot * world + p) * max_bytes) + gi);
+            ya = p == 0 ? g : __fadd_rn(ya, g);
+        }
+        const float y = __bfloat162float(__float2bfloat16_rn(ya));
+        const __nv_bfloat16* xr = x + r * wide + d;
+        const float x0 = __bfloat162float(xr[0]);
+        const float x1 = __bfloat162float(xr[D]);
+        const float x2 = __bfloat162float(xr[2 * D]);
+        const float x3 = __bfloat162float(xr[3 * D]);
+        const float* cr = comb + r * 16;
+        const float c0 = cr[0 * 4 + s], c1 = cr[1 * 4 + s], c2 = cr[2 * 4 + s], c3 = cr[3 * 4 + s];
+        const float ps = post[r * 4 + s];
+        const float v = __fmaf_rn(ps, y, __fmaf_rn(c3, x3, __fmaf_rn(c2, x2, __fmaf_rn(c0, x0, __fmul_rn(c1, x1)))));
+        xo[r * wide + (size_t)s * D + d] = __float2bfloat16_rn(v);
+    }
