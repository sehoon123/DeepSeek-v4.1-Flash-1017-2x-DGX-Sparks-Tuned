+    const bool n1 = v1 != v1, n2 = v2 != v2;
+    const bool gt = (v1 > v2) || (v1 == v2 && i1 < i2);
+    return (n1 && (!n2 || i1 < i2)) || (!n1 && !n2 && gt);
