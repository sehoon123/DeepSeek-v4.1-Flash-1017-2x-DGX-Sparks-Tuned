     /// Each held tree lane whose parent row the round reached: the target took it or not (its depth and rank).
+    /// Config.copy_ev: the copy window (tokens, first_copy to max_copy) with the most expected tokens a ms, a copied
+    /// token landing with the stream's record (q = (hits + 19) / (hits + misses + 20): a miss a window ends its run) and
+    /// a window of w tokens costing family_costs[w + 1] (timed at load): (sum q^i, i = 1..w, + 1) / ms.
+    fn bestCopy(e: *const Engine, s: *const Stream) u32 {
+        const hits: f64 = @floatFromInt(s.copy_hits);
+        const q = (hits + 19.0) / (hits + @as(f64, @floatFromInt(s.copy_misses)) + 20.0);
+        var best: u32 = e.cfg.max_copy;
+        var best_v: f64 = -1.0;
+        var lands: f64 = 0.0;
+        var qi: f64 = 1.0;
+        var w: u32 = 1;
+        while (w <= e.cfg.max_copy) : (w += 1) {
+            qi *= q;
+            lands += qi;
+            if (w < e.cfg.first_copy) continue;
+            const ms = e.cfg.family_costs.get(@intCast(w + 1)) orelse continue;
+            if (ms <= 0) continue;
+            const v = (lands + 1.0) / ms;
+            if (v > best_v) {
+                best_v = v;
+                best = w;
+            }
+        }
+        return best;
+    }
